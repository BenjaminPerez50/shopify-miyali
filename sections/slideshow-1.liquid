              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
      {%- endif -%}
      {%- endfor -%}
    </div>
  {%- endunless -%}
  {%- endif -%}
  {%- if section.blocks.size == 0 -%}
  <div class="placeholder-noblocks">
    {{ 'homepage.onboarding.no_content' | t }}
