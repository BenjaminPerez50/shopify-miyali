                  position: absolute;
                  top: 50%;
                  left: 0;
                  transform: translateY(-50%);
                  z-index: 1;
                }
                .header-search-parts-wrapper {
                  padding: 30px 30px 40px;
                  width: 330px;
                  max-width: 330px;
                  background-color: {{ block.settings.bg_title_filter }};
                }
                .header-search-parts-wrapper.active {
                  display: block;
                }
                .search-parts-title {
                  color: {{ block.settings.color_title_filter }};
                  display: flex;
                  gap: 10px;
                  align-items: center;
                  margin: 0 0 20px;
                }
                .form-group select {
                  width: 100%;
                  text-align: left;
                  text-transform: capitalize;
                }
                #search-{{ block.id }} select {
                  border: 1px solid rgb(var(--border-color))!important;
                  padding: 13.5px 14px;
                  border-radius: 3px;
                  text-transform: capitalize;
                  text-align: left;
                  flex: 1;

                  background-image: url('data:image/svg+xml;base64,');
                  background-repeat: no-repeat;
                  background-position: right 14px center;
                  -webkit-appearance: none;
                  -moz-appearance: none;
                  appearance: none;
                  margin-bottom: 10px;
                }
                .search-filter-button {
                  cursor: pointer;
                }
                #search-{{ block.id }} .btn-theme {
                  background-color: var(--g-main);
                  color: #fff;
                }
                #search-{{ block.id }} .btn-theme:before {
                  background-color: var(--g-main-2) !important;
                }
              </style>
              <div id="search-{{ block.id }}" class="container search-parts-head d-xl-block d-none">
                <div class="header-search-parts-wrapper">
                  {% if block.settings.title_search != blank %}
                  <div class="search-parts-title h6">
                    {{ block.settings.title_search }}
                  </div>
                  {% endif %}
                  <div class="">
                    <div id="search-filter" class="position-relative text-center">
                      <form role="form">
                        <div class="form-group d-flex flex-column mb-0">
              
                          <select class=" filter-top-collection" id="collection-select-1">
                            <option value="all" selected>{% if block.settings.content_filter != blank %}{{ block.settings.content_filter }}{% else %}All{% endif %}</option>
                            {% for collection in collections%}
                            <option value="{{ collection.handle }}">{{ collection.title }}</option>            
                            {% endfor %}
                          </select>
              
                          {% assign tags = block.settings.tag_lv_1 | split: ',' %}
                          <select class=" filter-top tag-select">
                            <option value=""  selected>{% if block.settings.content_filter_1 != blank %}{{ block.settings.content_filter_1 }}{% else %}All{% endif %}</option>
                            {% for t in tags %}
                            {% assign tag = t | strip %}
                            <option value="{{ tag | handle }}">{{ tag }}</option>
                            {% endfor %}
                          </select>    
              
                          {% assign tags = block.settings.tag_lv_2 | split: ',' %}
                          <select class="filter-top tag-select">
                            <option value="" selected>{% if block.settings.content_filter_2 != blank %}{{ block.settings.content_filter_2 }}{% else %}All{% endif %}</option>
                            {% for t in tags %}
                            {% assign tag = t | strip %}    
                            <option value="{{ tag | handle }}">{{ tag }}</option>
                            {% endfor %}
                          </select>
              
                          {% assign tags = block.settings.tag_lv_3 | split: ',' %}
                          <select class="filter-top tag-select">
                            <option value="" selected>{% if block.settings.content_filter_3 != blank %}{{ block.settings.content_filter_3 }}{% else %}All{% endif %}</option>
                            {% for t in tags %}
                            {% assign tag = t | strip %}
                            <option value="{{ tag | handle }}">{{ tag }}</option>
                            {% endfor %}
                          </select>
              
                          {% if block.settings.btn_search_filter != blank %}
                            <div class="w-100 btn button search-filter-button btn-theme">
                              {{ block.settings.btn_search_filter | upcase }}
                              {% render 'icon-arrow-2' %}
                            </div>
                          {% endif %}
              
                        </div>
                      </form>        
                    </div> 
                  </div>
                </div>
              </div>

          {%- endcase -%}
        {%- endfor -%}

    <div class="slide-social d-md-block d-none">
      {%- render 'block-social' , settings: section.settings -%}
    </div>
  </div>
  {%- unless section.settings.slideshow_mobile -%}
