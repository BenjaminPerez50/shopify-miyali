<!-- brand-swiper.liquid -->
<style>
  .customstyle{{ section.id }} .section-title-1 {
    font-weight: var(--g-h4-font-weight);
    font-size: var(--g-h4-font-size);
    line-height: var(--g-h4-font-lineheight);
    letter-spacing: var(--g-h4-font-spacing);
    text-transform: var(--g-h4-font-transform);
  }
  .customstyle{{ section.id }} .swiper-slide-visible {
    border-right: 1px solid var(--color-border);
  }
  {% if section.settings.nowrap %}
  .customstyle{{ section.id }} .swiper-container {
    overflow: visible;
  }
  {% endif %}
  {%- for block in section.blocks -%}
    {%- if block.settings.image != blank -%}
    .carousel__slide-wrapper--{{ block.id }} .image-content__image-container {
      max-width: {{ block.settings.image.width }}px;
    }
    {%- endif -%}
  {%- endfor -%}
</style>
{%- render 'style-section' -%}
<brand-swiper class="d-block brand-swiper customstyle{{ section.id }}" data-aos="{{ section.settings.animation }}">
  <span class="top"></span>
  <div class="{{ section.settings.setwidth }}">
      <div class="section-block">
        <div class="brand-sw-heading">
          <div style="gap: 15px 0;" class="{% if section.settings.arrow_heading %}swiper-wrapper-{{ section.id }} arrow-heading d-flex flex-wrap align-items-center justify-content-between mb-3 {% else %} section__header-wp{% endif %}">
                    
            <div class="section-heading-wp">
              {% render 'section-heading' %}
            </div>

            {% if section.settings.arrow_heading %}
            <div style="gap: 2px;" class="btn-prev-next d-flex position-relative justify-content-md-end justify-content-center">
              <div class="swiper-button-prev position-static mt-0">
                {% render "icon-swiper-prev" %}
              </div>
              <div class="swiper-button-next position-static mt-0">
                {% render "icon-swiper-next" %}
              </div>
            </div>
            {% endif %}
          
          </div>
        </div>
        <div class="brand-sw-wrapper position-relative">
          <div id="swipercol-{{ section.id }}" class="brand-wrapper swiper-container swipercol-{{ section.id }}" 
              data-section-id="{{ section.id }}"  
              data-section-type="swipercustom"
              data-perview-desktop="{{ section.settings.perviewDesktop }}"
              data-perview-tablet="{{ section.settings.perviewTablet }}"
              data-perview-mobile="{{ section.settings.perviewMobile }}"
              data-space-between="{{ section.settings.spaceBetween }}"
            >
              <div class="swiper-wrapper">
                  {%- for block in section.blocks -%}
                      <div class="swiper-slide brand-item carousel__slide-wrapper--{{ block.id }}" {{ block.shopify_attributes }}>
                          <div>
                              <div class="image-content__image-container overflow-hidden mx-auto" style="width: {{ section.settings.width_image }}%;">
                              <a href="{{ block.settings.link | default: '#' }}" 
                              class="image-content__image-wrapper d-block {% if section.settings.grayscale -%} hv-image-grayscale {% endif %}"
                              title="{{ block.settings.image.alt }}"
                              style="padding-top:{{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 }}%;">
                              {% assign img_url = block.settings.image | image_url: width: 1 | replace: 'width=1', 'width={width}' %}
                              {%- if block.settings.image != blank -%}
                              <img class="lazyload scale-in"
                                  src="{{ block.settings.image | image_url: width: 1, height: 1 }}" 
                                  data-widths="[180, 360, 540, 720, 900, 1080, 1296, 1512, 1728, 1944, 2048]"
                                  data-src="{{ img_url }}" 
                                  data-aspectratio="{{ block.settings.image.aspect_ratio }}"
                                  data-sizes="auto"
                                  alt="{{ block.settings.image.alt }}" 
                                  loading="lazy"
                                  width="{{ block.settings.image.width }}"
                                  height="{{ block.settings.image.height }}">
                              {%- else -%}
                              <div class="image-block__image">
                                  {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                              </div>
                              {%- endif -%}
                              </a>
                              </div>
                          </div>
                      </div>
                  {%- endfor -%}

              {%- if section.settings.scrollbar -%}
                  <div class="swiper-scrollbar"></div>
              {%- endif -%}

              </div>
          </div>
          {% if section.settings.arrow_heading != true %}
            {%- if section.settings.arrows -%}
            <div class="swiper-wrapper-{{ section.id }}">
              <div class="swiper-button-prev">
                  {% render "icon-swiper-prev" %}
              </div>
              <div class="swiper-button-next">
                  {% render "icon-swiper-next" %}
              </div>
            </div>
            {%- endif -%}
          {% endif %}
        </div>
      </div>
  </div>
  <span class="bottom"></span>
</brand-swiper>

