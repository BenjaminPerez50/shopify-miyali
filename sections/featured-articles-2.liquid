<!-- featured-articles-2.liquid -->
<style>
    .blog-section{{ section.id }}{
      position: relative;
      z-index: {{ section.settings.zindex }};
      --g-hgutter: 10px;
    }
    .blog-section{{ section.id }}::before{
      position: absolute;
      top:0;
      right:0;
      left:0;
      content: "";
      height: {{ section.settings.rangebg }}%;
      background-color: {{ section.settings.bgbefore }};
    }
    .blog-first .blog__item{
        position: relative;
    }
    .blog-list-right .blog__item{
      padding-bottom: 0;
      margin-bottom: 30px;
      gap: 0;
      align-items: center;
      background-color: #fff;
    }
    .article__photo-wrapper.portrait{
      padding-top: 120% !important;
      overflow: hidden;
    }
    .article__photo-wrapper.square{
      padding-top: 100% !important;
      overflow: hidden;
    }
    .article__photo-wrapper.landscape{
      padding-top: 75% !important;
      overflow: hidden;
    }
    .article__photo-wrapper.wide{
      padding-top: 56% !important;
      overflow: hidden;
    }
    .article__photo-wrapper.portrait img,.article__photo-wrapper.square img, .article__photo-wrapper.landscape img,.article__photo-wrapper.wide img{
      height: 100%;
      object-fit: cover;
    }

    .customstyle{{ section.id }} .blog__item .article__photo-container {
      max-height: 314px;
      border-radius: 0;
      min-height: 150px;
    }
    .customstyle{{ section.id }} .article__photo-wrapper img {
      height: 100%;
      object-fit: cover;
    }

    /* BLOG LEFT */
    .blog-list-left .blog__content {
      padding: 26px 30px 23px;
      background-color: #fff;
    }
    .blog__item .blog_tag {
      background-color: var(--g-main);
      color: #fff;
      padding: 5px 15px 7px;
      width: max-content;
      position: absolute;
      bottom: -8px;
      left: 30px;
    }
    .blog__item .blog-info p:not(:last-child) {
      margin-right: 13px;
      padding-right: 13px;
      border-right: 1px solid var(--color-border);
    }
    .blog__item .blog-info p {
      display: flex;
      align-items: center;
      gap: 4px;
    }
    .blog__item .blog-info time {
      color: var(--color-accent-3);
    }
    @media (max-width: 481px) {
      .blog-list-left .blog__content {
        padding: 20px;
      }
    }

    /* BLOG RIGHT */
    .blog-list-right .content-block__image {
      max-width: 220px;
      flex: 1;
    }
    .blog-list-right .blog__content {
      flex: 1;
      padding: 30px;
    }
    @media (max-width: 767px) {
      .blog-list-right .blog__item {
        flex-direction: column;
      }
      .blog-list-right .content-block__image {
        max-width: 100%;
        width: 100%;
      }
      .blog-list-right .blog__content {
        width: 100%;
      }
    }
  </style>
  {%-liquid
    assign image_size = section.settings.image_size  
  -%}
  <div class="customstyle{{ section.id }} blog-section{{section.id}}" data-aos="{{ section.settings.animation }}">
    {%- render 'style-section' -%}
  <div class="{{ section.settings.setwidth }}">
    <div class="section-block">
      {%- render 'section-heading' -%}
      <div class="bloglist-wrapper dots-negative " data-aos="{{ section.settings.animation }}">
        <div class="bloglist-slider row {% if section.settings.reverse %} flex-lg-row-reverse {% endif %}" >
          {%- assign blog = blogs[section.settings.blog] -%}
          {%- assign limit = 3 -%}
          {%- if blog != blank -%}
          <div class="col-lg-6">
          {%- for article in blog.articles limit: 1 -%}
            <div class="bloglist-item blog-list-left blog-first mb-20">
                <div class="blog__item pb-0">
                    {%- if article.image -%}
                        <div class="content-block__image position-relative">
                            <a href="{{ article.url }}">
                                <div class="article__photo-container">
                                <div class="article__photo-wrapper {{ image_size }}" style="padding-top:{{ 1 | divided_by: article.image.aspect_ratio | times: 100 }}%;">
                                    {%- assign img_url = article.image | image_url: width: 1 | replace: 'width=1', 'width={width}' -%}
                                    <img class="lazyload"
                                        src="{{ article.image | image_url: width: 1, height: 1 }}"
                                        data-src="{{ img_url }}"
                                        data-widths="[360, 540, 720, 900, 1080, 1296, 1512, 1728, 2048]"
                                        data-aspectratio="{{ article.image.aspect_ratio }}"
                                        data-sizes="auto"
                                        alt="{{ article.title | escape }}"
                                        loading="lazy"
                                        width="{{ article.image.width }}"
                                        height="{{ article.image.height }}">
                                </div>
                                </div>
                            </a>
                            <a href="{{ article.url }}" class="mask"></a>

                            {%- if article.tags.size > 0 -%}
                              <div class="blog_tag">
                                {%- for tag in article.tags limit: 1 -%}
                                <a href="{{ blog.url }}/tagged/{{ tag | handle }}">{{ tag }}</a>{% unless forloop.last %}, {% endunless %}
                                {%- endfor -%}
                              </div>
                            {%- endif -%}
                        </div>
                        {%- endif -%}
                        <div class="blog__content">
