<!-- featured-articles.liquid -->
<style>
  .blog-section{{ section.id }}{
    position: relative;
    z-index: {{ section.settings.zindex }};
  }
  .article__photo-wrapper.portrait{
    padding-top: 120% !important;
    overflow: hidden;
  }
  .article__photo-wrapper.square{
    padding-top: 100% !important;
    overflow: hidden;
  }
  .article__photo-wrapper.landscape{
    padding-top: 75% !important;
    overflow: hidden;
  }
  .article__photo-wrapper.wide{
    padding-top: 56% !important;
    overflow: hidden;
  }
  .article__photo-wrapper.portrait img,.article__photo-wrapper.square img, .article__photo-wrapper.landscape img,.article__photo-wrapper.wide img{
    height: 100%;
    object-fit: cover;
  }
  .bloglist-wrapper .blog__item{
    margin-bottom: 0 !important;
    padding-bottom: 0 !important;
  }
  .customstyle{{ section.id }} .col-custom-75 {
    padding-left: calc(75px / 2);
    padding-right: calc(75px / 2);
  }
  .customstyle{{ section.id }} .bloglist-slider.row-custom {
    margin-left: calc(-75px / 2);
    margin-right: calc(-75px / 2);
  }
  {% if section.settings.nowrap %}
  .customstyle{{ section.id }} .swiper-container {
    overflow: visible;
  }
  {% endif %}
</style>
{%- liquid

  assign image_size = section.settings.image_size
  assign enable_btn_blog = section.settings.enable_btn_blog
  assign enable_btn_line = section.settings.enable_btn_line
  assign enable_date = section.settings.enable_date
  assign enable_tag = section.settings.enable_tag
  assign enable_comment = section.settings.enable_comment
  assign enable_short = section.settings.enable_short
  
-%}
<div class="customstyle{{ section.id }} blog-section{{section.id}}" data-aos="{{ section.settings.animation }}">
  {%- render 'style-section' -%}
<div class="{{ section.settings.setwidth }}">
  <div class="section-block">

    <div style="gap: 15px 0;" class="{% if section.settings.arrow_heading %}swiper-wrapper-{{ section.id }} arrow-heading d-flex flex-wrap flex-md-row flex-column align-items-md-center align-items-center justify-content-between mb-4 pb-3 {% else %} section__header-wp{% endif %}">
              
      {% render 'section-heading' %}

      {% if section.settings.arrow_heading %}
      <div style="gap: 10px;" class="d-flex position-relative justify-content-md-end justify-content-center">
        <div class="swiper-button-prev position-static mt-0">
          {% render "icon-swiper-prev" %}
        </div>
        <div class="swiper-button-next position-static mt-0">
          {% render "icon-swiper-next" %}
        </div>
      </div>
      {% endif %}
    
    </div>

    <div class="bloglist-wrapper swiper-wrapper-{{ section.id }} dots-negative " data-aos="{{ section.settings.animation }}">
        <div id="Bloglist-{{ section.id }}" class="bloglist-slider swiper-container swipercol-{{ section.id }}" 
          data-section-id="{{ section.id }}"  
          data-section-type="swipercustom"
          data-perview-desktop="{{ section.settings.perviewDesktop }}"
          data-perview-tablet="{{ section.settings.perviewTablet }}"
          data-perview-mobile="{{ section.settings.perviewMobile }}"
          data-space-between="{{ section.settings.spaceBetween }}"
        >
          <div class="swiper-wrapper">
            {%- assign blog = blogs[section.settings.blog] -%}
            {%- assign limit = section.settings.limit -%}
            {%- if blog != blank -%}
              {%- for article in blog.articles limit: limit -%}
              <div class="swiper-slide bloglist-item">
                <div>
                  {%- liquid
                    case section.settings.item_style
                    when 'blog-1'
                      render 'blog-grid-1', article : article, image_size : image_size, enable_btn_blog : enable_btn_blog, enable_btn_line: enable_btn_line, enable_date : enable_date, enable_tag : enable_tag, enable_comment: enable_comment, enable_short : enable_short
                    when 'blog-3'
                      render 'blog-grid-3', article : article, image_size : image_size, enable_btn_blog : enable_btn_blog, enable_btn_line: enable_btn_line, enable_date : enable_date, enable_tag : enable_tag, enable_comment: enable_comment, enable_short : enable_short
                    when 'blog-5'
                      render 'blog-grid-5', article : article, image_size : image_size, enable_btn_blog : enable_btn_blog, enable_btn_line: enable_btn_line, enable_date : enable_date, enable_tag : enable_tag, enable_comment: enable_comment, enable_short : enable_short
                    when 'blog-6'
                      render 'blog-grid-6', article : article, image_size : image_size, enable_btn_blog : enable_btn_blog, enable_btn_line: enable_btn_line, enable_date : enable_date, enable_tag : enable_tag, enable_comment: enable_comment, enable_short : enable_short
                    when 'blog-7'
                      render 'blog-grid-7', article : article, image_size : image_size, enable_btn_blog : enable_btn_blog, enable_btn_line: enable_btn_line, enable_date : enable_date, enable_tag : enable_tag, enable_comment: enable_comment, enable_short : enable_short
                    else
                      render 'blog-grid-blank'
                    endcase
                  -%}
                </div>
              </div>
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..limit) -%}
              <div class="swiper-slide bloglist-item">
                <div data-aos="{{ section.settings.animation }}"  data-aos-delay="{{ forloop.index | times: 100 }}">
                {%- render 'blog-grid-blank' -%}
              </div>
              </div>
              {%- endfor -%}
            {%- endif -%}

          </div>
          {%- if section.settings.scrollbar -%}
            <div class="swiper-scrollbar"></div>
          {%- endif -%}
          {% if section.settings.arrow_heading != true %}
            {%- if section.settings.arrows -%}
              <div class="swiper-button-prev">
                {% render "icon-swiper-prev" %}
              </div>
              <div class="swiper-button-next">
                {% render "icon-swiper-next" %}
              </div>
            {%- endif -%}
          {% endif %}
      </div>
    </div>
    {%- render 'section-bot' -%}
  </div>
</div>
</div>

