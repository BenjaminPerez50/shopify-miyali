<!-- quotes-swiper.liquid -->
<style>
    .customstyle{{ section.id }} {
        --g-color-heading: {{ section.settings.color_heading }};
        --color-body-text: {{ section.settings.color_body }}
    }
    .quotes-bottom {
      font-family: var(--g-font-1);
      font-weight: 600;
      text-transform: uppercase;
      color: var(--g-color-heading);
    }
    @media (min-width:750px){
        .customstyle{{ section.id }} .quote-wrap{
            width:{{ section.settings.widthcolumn }}%;
        }
    }
    .customstyle{{ section.id }} .rating li.rated svg{
        fill: {{ section.settings.color_rated }};
    }

    {% if section.settings.background_image != blank %}
        .customstyle{{ section.id }} .swiper-button-prev, 
        .customstyle{{ section.id }} .swiper-button-next {
            background: #fff;
            border-color: #fff;
        }
    {% endif %}
    .customstyle{{ section.id }} .quote-content {
        padding-bottom: 60px;
        border-bottom: 1px solid var(--color-border);
        font-size: 18px;
        line-height: 24px;
        font-weight: 500;
    }
    .customstyle{{ section.id }} .h6 {
        font-size: 16px;
        line-height: 24px;
        letter-spacing: -0.02em;
    }
    {% if section.settings.nowrap %}
    .customstyle{{ section.id }} .swiper-container {
      overflow: visible;
    }
    {% endif %}

    .swiper-slide ,
    .customstyle{{ section.id }} .quote-wrap {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      padding: 0;
    }

    .quote-product {
      display: flex;
      gap: 20px;
      padding: 10px;
      border-radius: 10px;
      background-color: #fff;
      margin: 5px 0 0;
    }
    .quote-product > a {
      width: 60px;
      height: 72px;
      border-radius: 10px;
      overflow: hidden;
    }
    .media-body-title {
      font-size: 18px;
      font-weight: 600;
      line-height: 20px;
      margin-bottom: 7px;
      font-family: var(--g-font-1);
      color: var(--color-accent-3);
      text-transform: uppercase;
    }
    .swipercol-{{ section.id }} {
      margin-top: 31px;
    }
    .customstyle{{ section.id }} .txt-body  {
      font-size: 20px;
      line-height: 30px;
    }
    .customstyle{{ section.id }} .h1 {
      color: var(--g-main-2);
    }
    .customstyle{{ section.id }} .quote-wrap-top {
      gap: 14px;
    }
    @media (min-width: 1200px) {
      .customstyle{{ section.id }} .h1 {
        font-size: calc(var(--g-h1-font-size) + 20px);
      }
      .customstyle{{ section.id }} .swiper-slide:not(:last-child) {
        border-right: 1px solid var(--color-border);
      }
    }

    /* Popup Overlay */
    .video-popup-overlay {
      display: none;
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-color: rgba(0, 0, 0, 0.9);
      z-index: 9999;
    }
    .video-popup-content {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 80%;
      max-width: 800px;
      background: #000;
      border-radius: 10px;
      overflow: hidden;
    }

    .video-popup-content iframe {
      width: 100%;
      height: 450px;
    }

    .popup-close {
      position: absolute;
      top: 0;
      right: 0;
      padding: 0px 10px 5px;
      background: var(--primary);
      border: none;
      color: #fff;
      font-size: 30px;
      line-height: 17px;
    }

    button.play-btn {
      animation: spinnerRotate 6s linear infinite;
      border: none;
      border-radius: 10px;
      overflow: hidden;
    }

    button.play-btn svg {
      width: 90px;
      height: 90px;
      position: absolute;
      top: 50%;
      transform: translate(-50%,-50%);
      left: 50%;
    }

    .video-thumbnail img {
      object-fit: cover;
    }

    /* VIDEO IMAGE POPUP END */
    {%- for block in section.blocks -%}
    .carousel__slide-wrapper--{{ block.id }} .quote__slide {
      background-color: {{ section.settings.bg_item | color_to_rgb }};
      border-radius: 10px;
      {% if section.settings.show_bg_blur %}
      backdrop-filter: blur(30px);
      border: 1px solid rgba(0, 0, 0, 0.02);
      background-color: rgb({{ section.settings.bg_item | color_to_rgb | remove: 'rgb(' | remove: ')' }},.1);
      {% endif %}
    }
    {%- endfor -%}
</style>
{%- render 'style-section' -%}
<quotes-swiper class="d-block quotes-swiper customstyle{{ section.id }}" data-aos="{{ section.settings.animation }}">
    <div class="{{ section.settings.setwidth }}">
        <div class="section-block">
            {% render 'section-heading' %}

            <div id="swipercol-{{ section.id }}" class="quotes-wrapper swiper-container swipercol-{{ section.id }}" 
                data-section-id="{{ section.id }}"  
                data-section-type="swipercustom"
                data-perview-desktop="{{ section.settings.perviewDesktop }}"
                data-perview-tablet="{{ section.settings.perviewTablet }}"
                data-perview-mobile="{{ section.settings.perviewMobile }}"
                data-space-between="{{ section.settings.spaceBetween }}"
                data-initialslide="1"
            >
                <div class="swiper-wrapper">
                  {%- for block in section.blocks -%}
                      {%- case block.type -%}
                          {%- when 'quote' -%}
                          <div class="swiper-slide carousel__slide-wrapper--{{ block.id }} h-100" {{ block.shopify_attributes }}>
                              {%- liquid
                              assign style = section.settings.style
                              assign title = block.settings.title
                              assign quote = block.settings.quote
                              assign rate = block.settings.rate
                              assign avatar = block.settings.avatar
                              assign author = block.settings.author
                              assign info = block.settings.info
                              assign size_text = section.settings.size_text
                              assign aligntext = section.settings.aligntext

                              case style
                                  when 'style-1'
                                      render 'quote-style-1', title: title, quote: quote, rate: rate, avatar: avatar, author: author, info: info, size_text: size_text, aligntext: aligntext
                                  when 'style-2'
                                      render 'quote-style-2', title: title, quote: quote, rate: rate, avatar: avatar, author: author, info: info, size_text: size_text, aligntext: aligntext
                              endcase
                              -%}

                              {%- if block.settings.product != blank -%}
                              {% assign product = block.settings.product %}
                              <div class="quote-product align-items-center">
                                <a href="{{ product.url }}"><img class="mr-3 lazyload adv-img" 
                                  data-src="{{ product.featured_image | image_url: width: 150 }}" 
                                  src="{{ product.featured_image | image_url: width: 1, height: 1 }}"
                                  loading="lazy"
                                  width="{{ product.featured_image.width }}"
                                  height="{{ product.featured_image.height }}"></a>
                                <div class="media-body">
                                  <a href="{{ product.url }}" title="{{ product.title }}" class="media-body-title d-block">{{ product.title }}
                                  </a>
                                  {%- if product.available -%}
                                    <div class="product-card__price">
                                      {%- if product.compare_at_price > product.price -%}
                                        {%- if product.price_varies -%}
                                          {%- assign sale_price = product.price | money -%}
                                          {{ 'products.product.on_sale_from_html' | t: price: sale_price }}
                                        {%- else -%}
                                          <span class="visually-hidden">{{ 'products.product.regular_price' | t }}
                                          </span>
                                          <s class="product-card__regular-price">{{ product.compare_at_price | money }}
                                          </s>
                                          <span class="visually-hidden">{{ 'products.product.sale_price' | t }}
                                          </span>
                                          {{ product.price | money }}
                                        {%- endif -%}
                                      {%- else -%}
                                        {%- if product.price_varies -%}
                                          {%- assign price = product.price | money -%}
                                          {{ 'products.product.from_text_html' | t: price: price }}
                                        {%- else -%}
                                          <span class="visually-hidden">{{ 'products.product.regular_price' | t }}
                                          </span>
                                          {{ product.price | money }}
                                        {%- endif -%}
                                      {%- endif -%}
                                    </div>
                                  {%- else -%}
                                    <div class="product-card__availability">
                                      {{ 'products.product.sold_out' | t }}
                                    </div>
                                  {%- endif -%}
                                </div>
                              </div>                        
                              {%- endif -%}
                          </div>

                          {%- when 'video-popup' -%}
                            <style>
                              .custom-{{ section.id }} .video-thumbnail img {
                                width: {{ block.settings.size_img }}px;
                                height: {{ block.settings.size_img }}px;
                                border-radius: 50%;
                              }
                            </style>
                            <div class="swiper-slide video-popup h-100">
                              <div class="video-card h-100">
                                <div class="video-thumbnail h-100 w-100" data-video="https://www.youtube.com/embed/{{ block.settings.video_url.id }}">
                                  <button class="play-btn h-100 w-100 p-0 position-relative">
                                    {% if block.settings.featured_image != blank %}
                                        <img loading="lazy" class="h-100 w-100 m-0"
                                        sizes="(max-width: 740px) 80vw, (max-width: 999px) 60vw, 425px"
                                        alt="" 
                                        src="{{ block.settings.featured_image | image_url: width: block.settings.featured_image.width }}" 
                                        srcset="{%- if block.settings.featured_image.width >= 3000 -%}{{ block.settings.featured_image | image_url: width: 3000, crop: 'center' }} 3000w,{%- endif -%} {{ block.settings.featured_image | image_url }} {{ block.settings.featured_image.width }}w"
                                        src="{{ block.settings.featured_image | image_url: width: 1500 }}"
                                        height="{{ block.settings.featured_image.height }}"
                                        width="{{ block.settings.featured_image.width }}">
                                    {% else %}
                                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                                    {% endif %}

                                    <svg xmlns="http://www.w3.org/2000/svg" width="90" height="90" viewBox="0 0 90 90" fill="none">
                                      <circle cx="45" cy="45" r="45" fill="white"/>
                                      <path d="M39.6009 35.2657C39.3257 35.0889 39.0129 35 38.7 35C38.4165 35 38.1326 35.0727 37.8757 35.2197C37.3353 35.5281 37 36.1134 37 36.7499V54.2493C37 54.8858 37.3353 55.4711 37.8757 55.7796C38.416 56.0897 39.0768 56.071 39.6009 55.7335L53.2009 46.9839C53.6977 46.6634 54 46.1028 54 45.4996C54 44.8964 53.6977 44.3357 53.2009 44.0153L39.6009 35.2657Z" fill="black"/>
                                    </svg>
                                  </button>
                                </div>
                              </div>
                            </div>

                      {%- endcase -%}
                  {%- endfor -%}
                </div>

                {%- if section.settings.scrollbar -%}
                  <div class="swiper-scrollbar"></div>
                {%- endif -%}

                {%- if section.settings.arrows -%}
                  <div class="swiper-button-prev">
                      {% render "icon-swiper-prev" %}
                  </div>
                  <div class="swiper-button-next">
                      {% render "icon-swiper-next" %}
                  </div>
                {%- endif -%}
            </div>

            {% if section.settings.content_bottom != blank %}
            <div class="quotes-bottom text-center mt-xl-60 mt-4">
              {{ section.settings.content_bottom }}
            </div>
            {% endif %}
        </div>
    </div>
</quotes-swiper>

{%- for block in section.blocks -%}
  {%- case block.type -%}
    {%- when 'video-popup' -%}
      <div id="videoPopup" class="video-popup-overlay">
        <div class="video-popup-content">
          <iframe id="popupIframe" src="" frameborder="0" allow="autoplay; encrypted-media" allowfullscreen></iframe>
          <button id="closePopup" class="popup-close">&times;</button>
        </div>
      </div>
  {%- endcase -%}
{%- endfor -%}

