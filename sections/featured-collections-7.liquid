<!-- featured-collections-7.liquid -->
<style>
  .customstyle{{ section.id }} {
    --g-hgutter:{{ section.settings.space }}px;
  }
  .customstyle{{ section.id }} h4.p {
    font-size: var(--g-font-size);
    font-weight: 800;
    line-height: 20px;
  }
  .customstyle{{ section.id }} .count {
    font-size: calc(var(--g-font-size) - 2px);
    line-height: 20px;
    color: var(--color-accent-3);
  }
  .customstyle{{ section.id }} .collection-card__text {
    flex: 1;
  }
  .customstyle{{ section.id }} .collection-card-7 {
    min-height: 200px;
    background-color: {{ section.settings.bg_item }};
    padding: 20px;
  }
  .customstyle{{ section.id }} .collectionlist-item {
    padding: 0 {{ section.settings.space }}px;
  }
  .customstyle{{ section.id }} .slick-slide > div:not(:last-child) .collectionlist-item {
    {% if section.settings.rows == "2" %}
      padding-bottom: calc({{ section.settings.space }}px + {{ section.settings.space }}px);
    {% endif %}
  }
  @media (min-width: 577px) {
    .customstyle{{ section.id }} .collection-card-7 {
      padding: 0 30px;
      min-height: 100px;
    }
  }
</style>
<div class="customstyle{{ section.id }}"  data-aos="{{ section.settings.animation }}" >
{%- render 'style-section' -%}
  <div class="{{ section.settings.setwidth }}">
    <div class="section-block">
      {%- render 'section-heading' -%}
      <div class="collectionlist-wrapper">
        <div class="collectionlist-slider row" id="collection-list-{{ section.id }}"
            data-rows="{{ section.settings.rows }}"
            data-slidesToShow="{{ section.settings.show }}"
            data-arrows="{{ section.settings.arrows }}"
            data-dots="{{ section.settings.dots }}" 
            data-draggable="{{ section.settings.draggable }}" 
            data-infinite="{{ section.settings.infinite }}" 
            data-section-id="{{ section.id }}" 
            data-slidestoshow-mobile="2"
            {% if section.settings.enable_carousel %}
            data-section-type="slickCarousels"
            {% endif %}
          >
          {%- for block in section.blocks -%}
          <div class="collectionlist-item carousel__slide-wrapper--{{ block.id }}" {{ block.shopify_attributes }} >
            {%- assign featured_collection = collections[block.settings.collection] -%}
            {%- assign featured_image = block.settings.image -%}
            {%- capture current -%}{%- cycle 1, 2, 3, 4, 5, 6 -%}{%- endcapture -%}
            {%- assign collectionTitle = featured_collection.title | default: 'Collection title' -%}
            {%- liquid 
              if featured_image != blank 
                assign featured_image = featured_image
              else
                if featured_collection.image
                  assign featured_image = featured_collection.image | image_url: width: 1200
                else
                  assign featured_image = featured_collection.products.first | image_url: width: 1200 
                endif  
              endif        
            -%}
            <div class="collection-card-7 d-flex align-items-sm-center justify-content-between flex-sm-row flex-column" {{ block.shopify_attributes }}>
              <div class="collection-card__text">
                <h4 class="m-0 {{ section.settings.size_text }}">
                  <a class="" href="{{ featured_collection.url | default : '#' }}">
                    {{ collectionTitle }}
                  </a>
                </h4>
                <p class="count">{{ featured_collection.products_count | default: 0 }}
                  {% assign c = featured_collection.products_count | plus: 0 %}
                    {%- if c > 1 -%}
                      {{ 'collections.general.products' | t | default : 'products' }}
                  {%- else -%}
                      {{ 'collections.general.product' | t | default : 'products' }}
                  {%- endif -%}
                </p>
              </div>
              <div class="collection-card__image overflow-hidden position-relative prueba">
                <a class="hv-image-saturate" href="{{ featured_collection.url | default : '#' }}">        
                  {%- if featured_image != blank -%}
                  {% assign img_url = featured_image | image_url: width: 1 | replace: 'width=1', 'width={width}' %}
                  <style>
                    {% if section.settings.size_image == "custom" %}
                    .customstyle{{ section.id }} .carousel__slide-wrapper--{{ block.id }} .collection-card__image {
                      width: {{ section.settings.width_custom }}px;
                      height: {{ section.settings.width_custom }}px;
                    }
                    {% else %}
                    .customstyle{{ section.id }} .carousel__slide-wrapper--{{ block.id }} .collection-card__image {
                      width: auto;
                    }
                    @media (min-width: 577px) {
                      .customstyle{{ section.id }} .carousel__slide-wrapper--{{ block.id }} .collection-card__image {
                        width: {{ featured_image.width }}px;
                      }
                    }
                    {% endif %}
                  </style>
                  <img class="lazyload transition" 
                  src="{{ featured_image | image_url: width: 800 }}"
                  data-src="{{ img_url }}"
                  data-widths="[180, 360, 540, 720, 900, 1080, 1296, 1512, 1728, 1944, 2048]"
                  data-aspectratio="{{ featured_image.aspect_ratio }}"
                  data-sizes="auto"
                  loading="lazy"
                  width="{{ featured_image.width }}"
                  height="{{ featured_image.height }}">
                  {%- elsif featured_collection.image != blank -%}
                  {% assign img_url = featured_collection.image | image_url: width: 1 | replace: 'width=1', 'width={width}' %}
                  <img class="lazyload transition" 
                  src="{{ featured_collection.image | image_url: width: 800 }}"
                  data-src="{{ img_url }}" 
                  data-widths="[180, 360, 540, 720, 900, 1080, 1296, 1512, 1728, 1944, 2048]"
                  data-aspectratio="{{ featured_collection.image.aspect_ratio }}"
                  data-sizes="auto"
                  loading="lazy"
                  width="{{ featured_collection.image.width }}"
                  height="{{ featured_collection.image.height }}">
                  {%- else -%}
                  {{ 'collection-' | append: current | placeholder_svg_tag: class }}
                  {%- endif -%}
                </a>
              </div>
            </div>
          </div>
          {%- endfor -%}
        </div>
      </div>
      {%- if section.blocks.size == 0 -%}
      {%- render 'no-blocks' -%}
      {%- endif -%}
    </div>
  </div>
</div>


