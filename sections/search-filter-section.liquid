    {
      "type": "textarea",
      "id": "tag_lv_2",
      "label": "List tag level 2",
      "info": "Ex: 1 item, 2 item, 3 item..."
    },
    {
      "type": "header",
      "content": "List Tag level 3"
    },
    {
      "type": "text",
      "id": "filter_lv_3",
