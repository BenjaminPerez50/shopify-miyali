<style>
    .customstyle{{ section.id }} select {
        color: {{ section.settings.color_select }};
        border: 1px solid rgb(var(--border-color))!important;
        padding: 13.5px 14px;
        border-radius: 3px;
        text-transform: capitalize;
        text-align: left;
        flex: 1;

        background-image: url('data:image/svg+xml;base64,');
        background-repeat: no-repeat;
        background-position: right 14px center;
        -webkit-appearance: none;
        -moz-appearance: none;
        appearance: none;
        width: 250px;
    }
    .customstyle{{ section.id }} #search-filter {
        padding: 20px;
        background-color: {{ section.settings.bg_inner }};
        gap: 23px;
        z-index: 1;
    }
    .customstyle{{ section.id }} .form-group {
        gap: 10px;
    }
    .customstyle{{ section.id }} .label-filter {
        color: #fff;
        display: flex;
        align-items: center;
        gap: 10px;
        width: max-content;
    }
    .search-filter-button {
        cursor: pointer;
    }
    .customstyle{{ section.id }} .btn-theme {
        background-color: var(--g-main);
        color: #fff;
    }
    .customstyle{{ section.id }} .btn-theme:before {
        background-color: var(--g-main-2) !important;
    }
    @media (max-width: 576px) {
        .customstyle{{ section.id }} select ,
        .customstyle{{ section.id }} .form-group ,
        .customstyle{{ section.id }} form {
            width: 100%;
        }
    }
</style>

<section class="search-filter-section customstyle{{ section.id }}" data-aos="{{ section.settings.animation }}">
{%- render 'style-section' -%}
  <div class="{{ section.settings.setwidth }}">

    {% render 'section-heading' %}

      <div id="search-filter" class="position-relative d-flex align-items-center justify-content-center flex-md-row flex-column">
            {% if section.settings.collection-title != blank %}
                <label class="label-filter h6 mb-0">{{ section.settings.collection-title }}</label>
            {% endif %}
          <form role="form">
            <div class="form-group d-flex align-items-center flex-wrap flex-sm-row flex-column mb-0">
  
              <select class=" filter-top-collection" id="collection-select-1">
                <option value="all" selected>{% if section.settings.content_filter != blank %}{{ section.settings.content_filter }}{% else %}All{% endif %}</option>
                {% for collection in collections%}
                <option value="{{ collection.handle }}">{{ collection.title }}</option>            
                {% endfor %}
              </select>
  
              {% assign tags = section.settings.tag_lv_1 | split: ',' %}
              {% if section.settings.filter_lv_1 != blank %}
              <label class="label-filter">{{ section.settings.filter_lv_1 }}</label>
              {% endif %}
              <select class=" filter-top tag-select">
                <option value=""  selected>{% if section.settings.content_filter_1 != blank %}{{ section.settings.content_filter_1 }}{% else %}All{% endif %}</option>
                {% for t in tags %}
                {% assign tag = t | strip %}
                <option value="{{ tag | handle }}">{{ tag }}</option>
                {% endfor %}
              </select>    
  
              {% assign tags = section.settings.tag_lv_2 | split: ',' %}
              {% if section.settings.filter_lv_2 != blank %}
              <label  class="label-filter">{{ section.settings.filter_lv_2 }}</label>
                {% endif %}
              <select class="filter-top tag-select">
                <option value="" selected>{% if section.settings.content_filter_2 != blank %}{{ section.settings.content_filter_2 }}{% else %}All{% endif %}</option>
                {% for t in tags %}
                {% assign tag = t | strip %}    
                <option value="{{ tag | handle }}">{{ tag }}</option>
                {% endfor %}
              </select>
  
              {% if section.settings.filter_lv_3 != blank %}
              <label class="label-filter">{{ section.settings.filter_lv_3 }}</label>
                {% endif %}
              {% assign tags = section.settings.tag_lv_3 | split: ',' %}
              <select class="filter-top tag-select">
                <option value="" selected>{% if section.settings.content_filter_3 != blank %}{{ section.settings.content_filter_3 }}{% else %}All{% endif %}</option>
                {% for t in tags %}
                {% assign tag = t | strip %}
                <option value="{{ tag | handle }}">{{ tag }}</option>
                {% endfor %}
              </select>
  
              {% if section.settings.btn_search_filter != blank %}
                <div class="btn search-filter-button btn-theme">
                    {{ section.settings.btn_search_filter | upcase }}
                    {% render 'icon-arrow-2' %}
                </div>
              {% endif %}
  
            </div>
          </form>        
      </div> 
  </div>
</section>

