<!-- text-with-product.liquid -->
<style>
.twp-product-list {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    grid-gap: 20px;
}
.twp-content.is-sticky {
    padding: 60px 0 0;
}
.customstyle{{ section.id }} .pin-spacer {
    flex-basis: auto !important;
}
@media (min-width: 480px) {
  .twp-product-list {
    grid-template-columns: repeat(2, 1fr);
  }
}
</style>

<div class="customstyle{{ section.id }}" data-aos="{{ section.settings.animation }}" >
    {%- render 'style-section' -%}
    <div class="{{ section.settings.setwidth }}">

        <div class="row align-items-start">
            <div class="col-xl-4 col-lg-6 col-md-6">
                <div class="twp-content">
                    {%- render 'section-heading' -%}
                </div>
            </div>

            <div class="col-xl-8 col-lg-6 col-md-6">
                <div class="twp-product">
                    <div class="twp-product-list">
                        {% for block in section.blocks %}
                            {% case block.type %}
                                {%- when 'product' -%}
                                    {%- assign collection = collections[block.settings.collection] -%}
                                    {%- assign limit = block.settings.limit -%}
                                    {%- if collection != blank -%}
                                        {%- for product in collection.products limit: limit -%}
                                            <div class="twp-product-item">
                                                <div class="h-100" style="--g-color-heading : {{ settings.color_body_headings }};--g-color-heading-rgb:{{ settings.color_body_headings.red }}, {{ settings.color_body_headings.green }}, {{ settings.color_body_headings.blue }};
                                                --color-body-text: {{ settings.color_body_text }};--color-body-text-rgb: {{ settings.color_body_text.red }}, {{ settings.color_body_text.green }}, {{ settings.color_body_text.blue }};">
                                                    {%- render 'product-card', product: product -%}
                                                </div>
                                            </div>
                                        {%- endfor -%}
                                    {%- else -%}
                                        {%- for i in (1..limit) -%}
                                            <div class="twp-product-item">
                                                <div>
                                                    {%- render 'product-grid-blank' -%}
                                                </div>
                                            </div>
                                        {%- endfor -%}
                                    {%- endif -%}

                            {% endcase %}
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="{{ 'ScrollTrigger.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'gsap.min.js' | asset_url }}" defer="defer"></script>

<script>
document.addEventListener("DOMContentLoaded", function () {
  gsap.registerPlugin(ScrollTrigger);

  const section = document.querySelector(".customstyle{{ section.id }}");
  if (!section) return;

  const contentCol = section.querySelector(".col-xl-4.col-lg-6.col-md-6");
  const content = contentCol ? contentCol.querySelector(".twp-content") : null;
  const banner = section.querySelector(".twp-product");

  if (!content || !banner) return;

  function getPinDistance() {
    const bannerH = banner.getBoundingClientRect().height;
    const contentH = content.getBoundingClientRect().height;
    return Math.max(0, bannerH - contentH);
  }

  function initPin() {
    if (window._twbPinTrigger) {
      window._twbPinTrigger.kill();
      window._twbPinTrigger = null;
    }

    if (window.innerWidth < 767) return;

    window._twbPinTrigger = ScrollTrigger.create({
      trigger: section,
      start: "top top",
      end: () => "+=" + getPinDistance(),
      pin: contentCol,
      pinSpacing: true,
      anticipatePin: 1,
      onEnter: () => content.classList.add("is-sticky"),
      onLeave: () => content.classList.remove("is-sticky"),
      onEnterBack: () => content.classList.add("is-sticky"),
      onLeaveBack: () => content.classList.remove("is-sticky"),
    });
  }

  initPin();

  window.addEventListener("load", () => {
    ScrollTrigger.refresh();
    initPin();
  });

  let rT;
  window.addEventListener("resize", () => {
    clearTimeout(rT);
    rT = setTimeout(() => {
      ScrollTrigger.refresh();
      initPin();
    }, 150);
  });
});
</script>

