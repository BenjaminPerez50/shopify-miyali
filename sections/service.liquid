<!-- service.liquid -->

<style>
  {% if section.settings.size != 0 %}
  .customstyle{{ section.id }} .iconx8 svg, 
  .customstyle{{ section.id }} .iconx8 .icon, 
  .customstyle{{ section.id }} .iconx8 [class^=icon-]{
    width: {{ section.settings.size }}px;
    height: {{ section.settings.size }}px;
    font-size: {{ section.settings.size }}px;
  }
  .iconx8 img {
    width: {{ section.settings.size }}px;
    height: {{ section.settings.size }}px;
  }
  {% else %}
    .customstyle{{ section.id }} .iconx8 svg, 
    .customstyle{{ section.id }} .iconx8 .icon, 
    .customstyle{{ section.id }} .iconx8 [class^=icon-]{
      width: auto;
      height: auto;
      font-size: auto;
    }
    .iconx8 img {
      width: auto;
      height: auto;
    }
  {% endif %}
  /* SERVICE 1 */
  .service-1.text-center {
    flex-direction: column;
    align-items: center;
  }
  /* SERVICE 2 */
  .customstyle{{ section.id }} .service-2 {
    margin-bottom: calc(var(--g-hgutter) * 2);
  }
  .customstyle{{ section.id }} .service-2 .media-body {
    gap: 29px;
  }
  .customstyle{{ section.id }} .service-2 h5.p {
    font-size: 14px;
    line-height: 18px;
    font-weight: 500;
    margin: 0 0 12px;    
  }

  @media (min-width: 1200px) {
    .customstyle{{ section.id }} .services-item {
      width: max-content;
      flex: unset;
    }
    .services-slider.row {
      justify-content: space-between;
    }
  }

  {%- for block in section.blocks -%}
    .sv-bgsub-{{ section.id }} .carousel__slide-wrapper--{{ block.id }} .service-2 .media-body {
      padding: 20px 0;
    }
    @media (min-width: 768px) {
    .sv-bgsub-{{ section.id }} .carousel__slide-wrapper--{{ block.id }} .media-body {
      padding:{{ block.settings.paddingbox }};
      {% if block.settings.border_width != blank %}
      border-width: {{ block.settings.border_width }};
      border-style: solid;
      border-color: var(--color-border);
      {% endif %}
    }
  }
  {%- endfor -%}
</style>

{%- liquid
  assign carousel =  section.settings.enable_carousel
  assign service_heading = section.settings.service_heading
-%}
<div class="service-section customstyle{{ section.id }} {% if section.settings.layout == 'style-3' %} block-sv3 {% endif %}" data-aos="{{ section.settings.animation }}" >
  {%- render 'style-section' -%}
  <div class="{{ section.settings.setwidth }}">
    <div class="section-block sv-bgsub-{{ section.id }}" style="background-color: {{ section.settings.bg_box }};border-radius: 10px;">
      {%- render 'section-heading' -%}
      <div class="services-wrapper dots-negative">
        <div class="services-slider {% if section.settings.layout == 'style-1' %}services-slider-2{% endif %} row mb-0" id="service-list-{{ section.id }}"
            data-rows="{{ section.settings.rows }}"
            data-slidesToShow="{{ section.blocks.size }}"
            data-slidestoscroll="{{ section.blocks.size }}"
            data-arrows="{{ section.settings.arrows }}"
            data-dots="{{ section.settings.dots }}" 
            data-draggable="{{ section.settings.draggable }}" 
            data-infinite="{{ section.settings.infinite }}" 
            data-section-id="{{ section.id }}" 
            {% if carousel %}
            data-section-type="slickCarousels"
            {% endif %}>
          {%- for block in section.blocks -%}
          <div class="{% if carousel %}  col {% else %} col-12 col-lg col-md-6 mb-lg-0 mb-4 {% endif %} services-item carousel__slide-wrapper--{{ block.id }}" 
          {{ block.shopify_attributes }} >
          <div data-aos="{{ section.settings.animation }}"  data-aos-delay="{{ forloop.index | times: 100 }}">
            {%- case section.settings.layout -%}
            {%- when 'style-1' -%}
            <div class="media service-1 text-center" style="background-color:{{ block.settings.bgblock }};">
              <span class="iconx8 mb-33" style="color:{{ section.settings.iconcolor }};">
                {% if block.settings.icon != blank %}
                  {{ block.settings.icon }}
                {% else %}
                  {%- if block.settings.img_icon != blank -%}
                    <img 
                      src="{{ block.settings.img_icon | image_url: width: 1, height: 1 }}" 
                      class="lazyload transition" 
                      data-src="{{ block.settings.img_icon | image_url: width: 1920 }}"
                      loading="lazy"
                      width="{{ block.settings.img_icon.width }}"
                      height="{{ block.settings.img_icon.height }}">
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                {% endif %}
              </span>
              <div class="media-body">
                {%- if block.settings.title != blank -%}
                <h5 class="mt-0 mb-12 {{ service_heading }}" style="color:{{ section.settings.titlecolor }};">{{ block.settings.title }}</h5>
                {%- endif -%}
                <p style="color:{{ section.settings.subcolor }};">{{ block.settings.description }}</p>
              </div>
            </div>
            {%- when 'style-2' -%}
            <style>
              .media-text {
                flex: 0 1 auto;
              }
            </style>
            <div class="media service-2 text-md-left text-center mb-lg-0">
              <div class="media-body d-flex align-items-md-start align-items-center flex-md-row flex-column justify-content-lg-center justify-content-start" style="background-color:{{ block.settings.bgblock }};border-radius: 5px;">
                <div class="iconx8" style="color:{{ section.settings.iconcolor }};">
                  {% if block.settings.icon != blank %}
                    {{ block.settings.icon }}
                  {% else %}
                    {%- if block.settings.img_icon != blank -%}
                      <img 
                        src="{{ block.settings.img_icon | image_url: width: 1, height: 1 }}" 
                        class="lazyload transition" 
                        data-src="{{ block.settings.img_icon | image_url: width: 1920 }}"
                        loading="lazy" alt=""
                        width="{{ block.settings.img_icon.width }}"
                        height="{{ block.settings.img_icon.height }}">
                    {%- else -%}
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  {% endif %}
                </div>
                <div class="media-text">
                  {%- if block.settings.title != blank -%}
                    <h5 class="mt-0 {{ service_heading }} fw-semibold mb-1" style="color:{{ section.settings.titlecolor }};">{{ block.settings.title }}</h5>
                  {%- endif -%}
                  <p class="" style="color:{{ section.settings.subcolor }};">{{ block.settings.description }}</p>
                </div>
              </div>
            </div>
            {%- endcase -%}
          </div>
          </div>
          {%- endfor -%}
        </div>
      </div>
      {%- if section.blocks.size == 0 -%}
      {%- render 'no-blocks' -%}
      {%- endif -%}
    </div>
  </div>
</div>

