          "type": "select",
          "id": "text_align",
          "label": "Text align",
          "default": "center",
          "options": [
            {
              "value": "left",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ]
        },
        {
          "type": "text",
          "id": "width_content",
          "label": "Width content",
          "default": "820",
          "info": "Unit: px"
        },
        {
          "type": "color",
          "id": "color_text",
          "label": "Color text",
          "default": "#fff"
        },
        {
          "type": "liquid",
          "id": "subtitle",
          "label": "Sub Title",
          "default": "Sub Title"
        },
        {
          "type": "liquid",
          "id": "title",
          "label": "Heading",
          "default": "Image with text"
        },
        {
          "type": "select",
          "id": "size_text",
          "default": "h2",
          "options": [
