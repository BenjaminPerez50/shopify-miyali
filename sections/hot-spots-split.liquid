<!-- hot-spots-split.liquid -->
<style>
  .hotspots-text {
    position: absolute;
    top: 0;
    left: 0;
    bottom: 0;
    right: 0;
    padding: 20px 0;
  }
  .customstyle{{ section.id }} .buywith-name {
    font-size: 18px;
    line-height: 20px;
    font-weight: 600;
    font-family: var(--g-font-1);
    margin-bottom: 7px;
    color: var(--color-accent-3);
  }
  .customstyle{{ section.id }} .buywith-name:hover {
    color: var(--g-main);
  }
  .customstyle{{ section.id }} .rte-setting {
    font-size: 18px;
    line-height: 20px;
    font-weight: 600;
    text-transform: uppercase;
    font-family: var(--g-font-1);
  }
  .customstyle{{ section.id }} .js-grid-cart {
    font-weight: 600;
    color: var(--g-color-heading);
    text-decoration: none;
    margin-top: 30px;
    display: block;
    font-family: var(--g-font-1);
    text-transform: uppercase;
  }
  .customstyle{{ section.id }} .product-card>.product-card__image-wr>.product-card__image {
    padding-top: 0 !important;
    height: 72px;
  }
  .customstyle{{ section.id }} .hotspots-content-top {
    padding: 40px 20px 20px;
  }
  .customstyle{{ section.id }} .hotspots-container {
    background-color: #fff;
    border-radius: 10px;
    overflow: hidden;
  }
  .customstyle{{ section.id }} .js-countdown {
    border-top: 1px solid var(--color-border);
  }
  @media (min-width: 768px) {
    .hotspots-text {
      padding: 40px 20px;
    }
  }
  @media(min-width: 1200px) {
    .customstyle{{ section.id }} .h1 {
      font-size: 120px;
    }
    .customstyle{{ section.id }} .hotspots-content-top {
      padding: 140px 40px 20px;
    }
  }
  @media (max-width: 767px) {
    .customstyle{{ section.id }} .image-content__image-container > .image-content__image-wrapper {
      min-height: 500px;
    }
    .customstyle{{ section.id }} .image-content__image-container > .image-content__image-wrapper img {
      height: 100%;
    }
    .hotspots-text {
      padding: 20px;
    }
  }
</style>
{%- render 'style-section' -%}
<div class="customstyle{{ section.id }}" data-aos="{{ section.settings.animation }}" >
    <div class="section-block" >
      <div class="{{ section.settings.setwidth }}">
        <div class="row mx-0 position-relative">
            {%- for block in section.blocks -%}
              {%- liquid
                case block.settings.width 
                when '25%' 
                  assign block_width = 'col-lg-3' 
                when '33%' 
                  assign block_width = 'col-lg-4' 
                when '41%' 
                  assign block_width = 'col-lg-5' 
                when '50%' 
                  assign block_width = 'col-lg-6 ' 
                when '58%' 
                  assign block_width = 'col-lg-7' 
                when '66%' 
                  assign block_width = 'col-lg-8' 
                when '75%' 
                  assign block_width = 'col-lg-9' 
                when '100%' 
                  assign block_width = 'col-lg-12' 
              endcase 
              -%}
              {%- case block.type -%}
                {%- when 'feature' -%}
                {%-liquid
                  assign position_text = block.settings.position_text

                  case position_text
                    when 'top-left'
                    assign positiontxt = 'align-items-start justify-content-start'
                    when 'top-center'
                    assign positiontxt = 'align-items-center justify-content-start'
                    when 'top-right'
                    assign positiontxt = 'align-items-end justify-content-start'
                    when 'mid-left'
                    assign positiontxt = 'align-items-start justify-content-center'
                    when 'mid-center'
                    assign positiontxt = 'align-items-center justify-content-center'
                    when 'mid-right'
                    assign positiontxt = 'align-items-end justify-content-center'
                    when 'bot-left'
                    assign positiontxt = 'align-items-start justify-content-end'
                    when 'bot-center'
                    assign positiontxt = 'align-items-center justify-content-end'
                    when 'bot-right'
                    assign positiontxt = 'align-items-end justify-content-end'
                    else 
                    assign positiontxt = 'align-items-end justify-content-start'
                  endcase
                -%}
                <style>
                  .customstyle{{ section.id }} .subtop ,
                  .customstyle{{ section.id }} h3 ,
                  .customstyle{{ section.id }} .rte-setting {
                    color: {{ block.settings.color_text }};
                  }
                  .hotspots-container {
                    max-width: {{ block.settings.width_content }}px;
                    width: 100%;
                  }
                  {% if block.settings.height_mb != blank %}
                  @media (max-width: 768px) {
                    .customstyle{{ section.id }} .customstyle-{{ block.id }} .image-content__image-wrapper ,
                    .customstyle{{ section.id }} .customstyle-{{ block.id }} .image-content__image {
                      height: {{ block.settings.height_mb }}px;
                      object-fit: cover;
                    }
                  }
                  {% endif %}
                </style>
                <div class="{{ block_width }} customstyle-{{ block.id }} col-12 px-0" data-aos="{{ section.settings.animation }}" data-aos-delay="{{ forloop.index | times: 100 }}">
                    <div class="image-content__image-container  {% if block.settings.enable_height %} h-100 {% endif %}">
                        {%- if block.settings.image != blank -%}
                        <div class="{% if block.settings.image_mobile != blank %} d-none d-lg-block {% endif %} position-relative image-content__image-wrapper overflow-hidden {% if block.settings.enable_height %} h-100 {% endif %}" 
                            style="padding-top:{{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 }}%;">
                            {% assign img_url = block.settings.image | image_url: width: 1 | replace: 'width=1', 'width={width}' %}
                            <img class="image-content__image lazyload scale-in"
                                src="{{ block.settings.image | image_url: width: 1, height: 1 }}"
                                data-src="{{ img_url }}"
                                data-widths="[180, 360, 540, 720, 900, 1080, 1296, 1512, 1728, 1944, 2048]"
                                data-aspectratio="{{ block.settings.image.aspect_ratio }}"
                                data-sizes="auto"
                                alt="{{ block.settings.image.alt | escape }}"
                                loading="lazy"
                                width="{{ block.settings.image.width }}"
                                height="{{ block.settings.image.height }}"
                              style="{% if block.settings.enable_height %} height:100%;object-fit:cover; {% endif %}">

                              <div class="hotspots-text d-flex flex-column {{ positiontxt }}">
                                <div class="hotspots-container">
                                  <div class="text-{{ block.settings.text_align }}">
                                    <div class="hotspots-content-top">
                                      {%- if block.settings.subtitle != blank -%}
                                        <div class="subtop mb-20">{{ block.settings.subtitle }}</div>
                                      {%- endif -%}
                                      {%- if block.settings.title != blank -%}
                                        <h3 class="{% if block.settings.description != blank or block.settings.button_text != blank %} mb-xl-120 mb-40 {% endif %} mb-1 {{ block.settings.size_text }} ">{{ block.settings.title }}</h3>
                                      {%- endif -%}                                   
                                      <div style="gap: 5px 0;" class="d-flex justify-content-between align-items-center flex-sm-row flex-column">
                                        {%- if block.settings.description != blank -%}
                                          <div class="rte-setting txt-body mb-0">{{ block.settings.description }}</div>
                                        {%- endif -%}
                                        {%- if block.settings.button_text != blank -%}
                                          <a href="{{ block.settings.button_link }}" class="btn-underline">
                                            <u>
                                              {{ block.settings.button_text }}
                                            </u>
                                            {% render 'icon-arrow-2' %}
                                          </a>
                                        {%- endif -%}
                                      </div>
                                    </div>

                                    {%- if block.settings.data_countdown != blank -%}
                                      <div class="js-countdown countdown-item-1 text-center mt-0" data-time="{{ block.settings.data_countdown }}"></div>
                                    {%- endif -%}
                                  </div>
                                </div>
                              </div>
                        </div>

                        {%- if block.settings.image_mobile != blank -%} 
                          <div class="d-lg-none position-relative image-content__image-wrapper overflow-hidden" 
                              style="padding-top:{{ 1 | divided_by: block.settings.image_mobile.aspect_ratio | times: 100 }}%;">
                              {% assign img_url = block.settings.image_mobile | image_url: width: 1 | replace: 'width=1', 'width={width}' %}
                              <img class="image-content__image lazyload scale-in"
                                  src="{{ block.settings.image_mobile | image_url: width: 1, height: 1 }}"
                                  data-src="{{ img_url }}"
                                  data-widths="[180, 360, 540, 720, 900, 1080, 1296, 1512, 1728, 1944, 2048]"
                                  data-aspectratio="{{ block.settings.image_mobile.aspect_ratio }}"
                                  data-sizes="auto"
                                  alt="{{ block.settings.image_mobile.alt | escape }}"
                                  loading="lazy"
                                  width="{{ block.settings.image_mobile.width }}"
                                  height="{{ block.settings.image_mobile.height }}"
                                >
                          </div>
                        {%- endif -%}
                        {%- else -%}
                        <div class="image-content__image">
                            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                          </div>
                        {%- endif -%}
                        {%- for i in (1..3) -%}
                            {%- liquid
                                assign sProduct = 'product' | append: i 
                                assign sPos = 'pos' | append: i
                                assign sLeft = 'left' | append: i 
                                assign sTop = 'top' | append: i 
                                assign mLeft = 'mobile_left' | append: i 
                                assign mTop = 'mobile_top' | append: i 
                              -%}
                              {%- if block.settings[sProduct] != blank -%}
                                {%- assign productLookbook = all_products[block.settings[sProduct]] -%}
                                <style>
                                  .hotspot-{{ block.id }}-{{ forloop.index }}{
                                    --hot-top:{{ block.settings[sTop] }}%;
                                    --hot-left:{{ block.settings[sLeft] }}%;
                                    --dot-color: {{ block.settings.dot_color.red }},{{ block.settings.dot_color.green }},{{ block.settings.dot_color.blue }};
                                    top:var(--hot-top);
                                    left: var(--hot-left);
                                    z-index: 1;
                                  }
                                  @media (max-width:991px){
                                    .hotspot-{{ block.id }}-{{ forloop.index }}{
                                      --hot-top-mobile: {{ block.settings[mTop] }}%;
                                      --hot-left-mobile: {{ block.settings[mLeft] }}%;
                                      top:var(--hot-top-mobile);
                                    left: var(--hot-left-mobile);
                                    }
                                  }
                                </style>
                                <div class="hotspot-dotwrap position-absolute hotspot-{{ block.settings[sPos] }} hotspot-{{ block.id }}-{{ forloop.index }}" >
                                    <button class="hotspot-dot"  id="pover-{{ block.id }}" data-hotspot>
                                        <span class="visually-hidden">{{ productLookbook.title }}</span>
                                        <div>
                                        </div>
                                    </button>
                                    <div  class="popover-content" > 
                                        <div id="popover-{{ block.id }}">
                                            <div class="hotspot-product hotspot-product">
                                                {% render 'product-grid-buywith', product: productLookbook, firstimage: false, enablqv: false %}
                                            </div> 
                                        </div>
                                    </div>
                                </div>
                            {%- endif -%}
                        {%- endfor -%} 
                        
                    </div>
                </div>
                {%- when 'feature-right' -%}
                  <div class="{{ block_width }} col-12 px-0" data-aos="{{ section.settings.animation }}" data-aos-delay="{{ forloop.index | times: 100 }}">
                    {%- assign color = block.settings.color -%}
                    <div class="customright px-lg-5 px-4 pt-lg-5 pt-4 h-100 " 
                      style="background:{{ block.settings.bgcolor }};
                      --g-color-heading:{{ color }};
                      --g-font-color-subtop:{{ color }};
                      --color-body-text:{{ color }};
                      --color-body-text-rgb:{{ color.red }}, {{ color.green }},{{ color.blue }};
                      ">
                      <div class="pt-lg-4 px-lg-5 pb-0">
                        <div class="{% if block.settings.sub_title_block != blank  or block.settings.title_block != blank %} mb-5 {% endif %} d-flex  flex-column text-center justify-content-center">
                          {%- if block.settings.sub_title_block != blank -%}
                            <span class="subtop">{{ block.settings.sub_title_block }} </span>
                          {%- endif -%}
                          {%- if block.settings.title_block != blank -%}
                          <h3 class="py-2">{{ block.settings.title_block }}</h3>
                          {%- endif -%}
                        </div>
                        {%- if block.settings.data_countdown != blank -%}
                        <div class="js-countdown countdown-item-1 text-center mb-5" data-time="{{ block.settings.data_countdown }}"></div>
                      {%- endif -%}
                        {%- if block.settings.code != blank -%}
                          <div>
                            {{ block.settings.code }}
                          </div>
                        {%- endif -%}
                        {%- if block.settings.button_text != blank -%}
                          <div class="text-center mb-5">
                            <a class="btn btn-theme" href="{{ block.settings.button_link | default: "#" }}"> {{ block.settings.button_text }} </a>
                          </div>
                          {%- endif -%}
                        {%- if block.settings.image != blank -%}
                          <div class="position-relative image-content__image-wrapper overflow-hidden" 
                              style="padding-top:{{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 }}%;">
                              {% assign img_url = block.settings.image | image_url: width: 1 | replace: 'width=1', 'width={width}' %}
                              <img class="image-content__image lazyload scale-in"
                                  src="{{ block.settings.image | image_url: width: 1, height: 1 }}"
                                  data-src="{{ img_url }}"
                                  data-widths="[180, 360, 540, 720, 900, 1080, 1296, 1512, 1728, 1944, 2048]"
                                  data-aspectratio="{{ block.settings.image.aspect_ratio }}"
                                  data-sizes="auto"
                                  alt="{{ block.settings.image.alt | escape }}"
                                  loading="lazy"
                                  width="{{ block.settings.image.width }}"
                                  height="{{ block.settings.image.height }}">
                          </div>
                        {%- endif -%}
                        
                      </div>
                    </div>
                  </div>

              {%- endcase -%}
            {%- endfor -%}

            {%- for block in section.blocks -%}
              {%- case block.type -%}
                {%- when 'img-child' -%}
                  <style>     
                    #imgchild-{{ block.id }} img {
                      object-fit: cover;
                    }                             
                    #imgchild-{{ block.id }} {
                      --hot-top:{{ block.settings.sTop }}%;
                      --hot-left:{{ block.settings.sLeft }}%;
                      top:var(--hot-top);
                      left: var(--hot-left);
                      width: 320px;
                      height: 420px;
                      max-width: 320px;
                      max-height: 420px;
                      padding: 15px 15px 55px 15px;
                      background-color: #fff;
                      border-radius: 10px;
                      transform: rotate({{ block.settings.deg }}deg);
                      box-shadow: 0px 0px 15px 0px rgba(0, 0, 0, 0.1);
                    }
                    @media (max-width:749px){
                      #imgchild-{{ block.id }} {
                        --hot-top-mobile: {{ block.settings.mTop }}%;
                        --hot-left-mobile: {{ block.settings.mLeft }}%;
                        top:var(--hot-top-mobile);
                        left: var(--hot-left-mobile);
                      }
                    }
                  </style>
                    <div id="imgchild-{{ block.id }}" class="hot-img-child position-absolute d-xxl-block d-none">
                      {%- if block.settings.image != blank -%}
                        {% assign img_url = block.settings.image | image_url: width: 1 | replace: 'width=1', 'width={width}' %}
                        <img src="{{ block.settings.image | image_url: width: 1, height: 1 }}" 
                          class="lazyload scale-in w-100 h-100" 
                          data-src="{{ img_url }}" 
                          data-widths="[180, 360, 540, 720, 900, 1080, 1296, 1512, 1728, 1944, 2048]"
                          data-aspectratio="{{ block.settings.image.aspect_ratio }}"
                          data-sizes="auto"
                          loading="lazy"
                          width="{{ block.settings.image.width }}"
                          height="{{ block.settings.image.height }}" />
                      {%- else -%}
                        {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                      {%- endif -%}
                    </div>
              {%- endcase -%}
            {%- endfor -%}

        </div>
      </div>
    </div>
</div>


