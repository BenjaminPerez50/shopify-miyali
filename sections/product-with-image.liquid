<!-- product-with-image.liquid  -->
<style>
    @media (min-width: 992px){
      .customstyle{{ section.id }} .product-image{
        display: flex;
        column-gap: 0;
        row-gap:var(--g-gutter) ;
      }
      .customstyle{{ section.id }} .product-image__item {
        width: 236px;
      }
      .customstyle{{ section.id }} .product-image__product {
        flex: 1;
        width: 50%;
      }
    }
    @media (min-width:1200px){
      .customstyle{{ section.id }} .product-image__item {
        width: 436px;
      }
      .customstyle{{ section.id }} .product-image__product {
        flex: 1;
        width: 50%;
      }
    }
    .customstyle{{ section.id }} .product-image__item .image-content__image-wrapper img{
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .customstyle{{ section.id }} .product-image__product .row{
        row-gap:0;
    }
    .customstyle{{ section.id }} .product-image__product .product-card__info{
        margin-bottom: 0;
        padding-bottom: 0;
    }
    .customstyle{{ section.id }} .product-image__banner{
        --bg-overlay-rgba:0,0,0;
        --bg-opacity:0;
        width: 100%;
        top:0;
        left:0;
        height: 100%;
        padding: 2.5rem;
        background-color: rgba(var( --bg-overlay-rgba),var(--bg-opacity));
    }
    .customstyle{{ section.id }} .product-video__banner{
        top:0;
        left:0;
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .customstyle{{ section.id }} .swiper-button-prev, 
    .customstyle{{ section.id }} .swiper-container-rtl .swiper-button-next {
      left: -16px;
      right: auto;
    }
    .customstyle{{ section.id }} .swiper-button-next, 
    .customstyle{{ section.id }} .swiper-container-rtl .swiper-button-prev {
      right: -16px;
      left: auto;
    }
    @media (max-width: 481px){
      .customstyle{{ section.id }} .product-image__banner {
        padding: 1.5rem;
      }
    }
</style>
<div class="customstyle{{ section.id }}"  data-aos="{{ section.settings.animation }} ">
  {%- render 'style-section' -%}
  <div class="{{ section.settings.setwidth }}">
    <div class="section-block">
        {%- render 'section-heading' -%}
          <div class="product-image {% if section.settings.pos_image == 'left_small' %} image_left_small {% elsif section.settings.pos_image == 'right_small' %} image_right_small  {% endif %}">
            {%- for block in section.blocks -%}
                {%- case block.type -%}
                    {%- when 'banner' -%}
                    <div class="product-image__item ">
                         {%- liquid 
                            assign text_color = block.settings.colortabimage 
                            assign pos_banner = block.settings.pos_banner
                            case pos_banner
                            when 'top-left'
                            assign positiontxt = 'align-items-start justify-content-start'
                            when 'top-center'
                            assign positiontxt = 'align-items-start justify-content-center text-center'
                            when 'top-right'
                            assign positiontxt = 'align-items-start justify-content-end text-right'
                            when 'mid-left'
                            assign positiontxt = 'align-items-center justify-content-start'
                            when 'mid-center'
                            assign positiontxt = 'align-items-center justify-content-center text-center'
                            when 'mid-right'
                            assign positiontxt = 'align-items-center justify-content-end text-right'
                            when 'bot-left'
                            assign positiontxt = 'align-items-end justify-content-start'
                            when 'bot-center'
                            assign positiontxt = 'align-items-end justify-content-center text-center'
                            when 'bot-right'
                            assign positiontxt = 'align-items-end justify-content-end text-right'
                            else 
                            assign positiontxt = 'align-items-end justify-content-start'
                        endcase
                         -%}
                       
                      <div class="image-content__image-container h-100 overflow-hidden">
                        {%- if block.settings.image != blank -%}
                          <div class="h-100" >
                              {% assign img_url = block.settings.image | image_url: width: 1 | replace: 'width=1', 'width={width}' %}
                              <img class="image-content__image lazyload scale-in w-100 h-100 object-fit-cover"
                                  src="{{ block.settings.image | image_url: width: 720 }}"
                                  data-src="{{ img_url }}"
                                  data-widths="[180, 360, 540, 720, 900, 1080, 1296, 1512, 1728, 1944, 2048]"
                                  data-aspectratio="{{ block.settings.image.aspect_ratio }}"
                                  data-sizes="auto"
                                  alt="{{ block.settings.image.alt | escape }}"
                                  loading="lazy"
                                  width="{{ block.settings.image.width }}"
                                  height="{{ block.settings.image.height }}"> 
                          </div>
                          {%- else -%}
                            <div class="image-content__image h-100 ">
                                {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                            </div>
                        {%- endif -%}
                        {%- if block.settings.video != blank -%}
                            <video class="product-video__banner  position-absolute" id="Mp4{{ section.id }}"  loop="" muted="" playsinline="" autoplay="" >
                                <source src="{{ block.settings.video }}" type="video/mp4">
                            </video>
                        {%- endif -%}
                            <div class="product-image__banner position-absolute d-flex {{ positiontxt }}" style="
                                    --bg-overlay-rgba: {{ block.settings.bg-overlay.red }}, {{ block.settings.bg-overlay.green }}, {{ block.settings.bg-overlay.blue }};
                                    --bg-opacity: {{ block.settings.bg-opacity }};
                                    {%- if text_color != 'transparent' -%}
                                    --g-font-color-subtop: {{ text_color }};
                                    --g-color-heading :  {{ text_color }};
                                    --color-body-text : {{ text_color }};
                                    --color-body-text-rgb: {{ text_color.red }}, {{ text_color.green }},  {{ text_color.blue }} ;
                                {%- endif -%} ">
                                    <div  class="product-image__banner_in">
                                        {%- if block.settings.subtitle != blank -%}
                                            <div class="subtop mb-3">{{ block.settings.subtitle }}</div>
                                        {%- endif -%}
                                        {%- if block.settings.title != blank -%}
                                        <h3 class="mb-3 pb-1 {{ block.settings.size_text }}"><a href="{{ block.settings.link }}" >{{ block.settings.title }}</a></h3>
                                        {%- endif -%}
                                        {%- if block.settings.subtext != blank -%}
                                            <div class="rte mb-3 pb-1 txt-body d-flex flex-column">
                                              {% assign features = block.settings.subtext | newline_to_br | split: '<br />' %}
                                              {% for feature in features %}
                                                {% unless feature == blank %}
                                                  <span><span class="check-icon"></span> {{ feature | strip }}</span>
                                                {% endunless %}
                                              {% endfor %}
                                            </div>
                                        {%- endif -%}
                                    {%- if block.settings.button != blank and block.settings.link != blank -%}
                                        <div class="pt-0">
                                            <a href="{{ block.settings.link }}" class="btn {{ block.settings.style_btn }}">
                                            {{ block.settings.button | escape }}
                                            {% render 'icon-arrow-2' %}
                                            </a>
                                        </div>
                                        {%- endif -%}
                                    </div>
                            </div>
                            
                      </div>
                      
                    </div>
                    {%- when 'product' -%}
                        <div class="product-image__product position-relative">
                          <div class="productlist-swiper swiper-container swipercol-{{ section.id }}" id="pwi-{{ section.id }}"
                            data-section-id="{{ section.id }}"  
                            data-section-type="swipercustom"
                            data-perview-desktop="{{ block.settings.perviewDesktop }}"
                            data-perview-tablet="{{ block.settings.perviewTablet }}"
                            data-perview-mobile="{{ block.settings.perviewMobile }}"
                            data-space-between="{{ block.settings.spaceBetween }}"
                            >
                            <div class="swiper-wrapper">
                              {%- assign collection = collections[block.settings.collection] -%}
                              {%- assign limit = block.settings.limit -%}
                              {%- if collection != blank -%}
                              {%- for product in collection.products limit: limit -%}
                              <div class="pwi-item swiper-slide ">
                                  <div class="h-100" 
                                  style="--g-color-heading : {{ settings.color_body_headings }};
                                  --g-color-heading-rgb:{{ settings.color_body_headings.red }}, {{ settings.color_body_headings.green }}, {{ settings.color_body_headings.blue }};
                                  --color-body-text: {{ settings.color_body_text }};
                                  --color-body-text-rgb: {{ settings.color_body_text.red }}, {{ settings.color_body_text.green }}, {{ settings.color_body_text.blue }};">
                                    {%- render 'product-card', product: product -%}
                                  </div>
                              </div>
                              {%- endfor -%}
                              {%- else -%}
                              {%- for i in (1..limit) -%}
                              <div class="pwi-item swiper-slide">
                                <div>
                                  {%- render 'product-grid-blank' -%}
                                </div>
                              </div>
                              {%- endfor -%}
                              {%- endif -%}
                            </div>

                          </div>
                          {%- if block.settings.arrows -%}
                            <div class="swiper-wrapper-{{ section.id }}">
                              <div class="swiper-button-prev">
                                {% render "icon-swiper-prev" %}
                              </div>
                              <div class="swiper-button-next">
                                {% render "icon-swiper-next" %}
                              </div>
                            </div>
                          {%- endif -%}
                        </div>
                {%- endcase -%}
            {%- endfor -%}
          </div>
    </div>
  </div>
</div>

