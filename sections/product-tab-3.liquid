<!-- product-tab-3.liquid  -->
{%- style -%}
.customstyle{{ section.id }} .product-image__banner {
    top: 0;
    text-align: center;
    padding: 40px;
    left: 0;
    width: 100%;
}
.customstyle{{ section.id }} .tab-banner .subtop {
  color: {{ section.settings.color_sub }};
}
.customstyle{{ section.id }} .tab-banner h3 {
  color: {{ section.settings.color_title }};
  font-size: calc(var(--g-h3-font-size) - 2px);
}
.customstyle{{ section.id }} .producttab3-heading_left .btn-underline svg {
  color: var(--g-main);
}
@media (min-width: 577px) {
  .customstyle{{ section.id }} .tab-banner {
    width: 270px;
  }
  .customstyle{{ section.id }} .tab-content {
    flex: 1;
    width: 50%;
  }
  .customstyle{{ section.id }} .btn-heading {
    padding-left: 15px;
    margin-left: 15px;
    border-left: 1px solid var(--color-border);
  }
}

/* NAV TAB */
.customstyle{{ section.id }} .nav-tabs.nav-tabs-1 {
  gap: 0;
  box-shadow: none;
}
.customstyle{{ section.id }} .nav-tabs.nav-tabs-1 .nav-link {
  padding: 0;
  opacity: 1;
  font-weight: 700;
  text-transform: capitalize;
  color: var(--color-accent-3);
}
.customstyle{{ section.id }} .nav-tabs.nav-tabs-1 .nav-item:not(:last-child) {
  margin-right: 15px;
  padding-right: 15px;
  border-right: 1px solid var(--color-border);
}
.customstyle{{ section.id }} .nav-tabs.nav-tabs-1 .nav-link.active {
  color: var(--g-main);
}
.customstyle{{ section.id }} .nav-tabs.nav-tabs-1 .nav-link.active:before {
  display: none
}
{%- endstyle -%}
<div class="customstyle{{ section.id }} "  data-aos="{{ section.settings.animation }}" >
  {%- render 'style-section' -%}
  <div class="{{ section.settings.setwidth }}">
    <div class="section-block">
        <div id="Producttab-3-{{ section.id }}" data-section-id="{{ section.id }}" >
            <div class="d-flex align-items-center justify-content-between gap-3 mb-2 pb-1 flex-wrap">
                <div class="producttab3-heading_left d-flex align-items-sm-center flex-wrap row-gap-3 flex-sm-row flex-column">
                    {%- if section.settings.title != blank -%}
                    <h3 class="h4 mb-0 mr-4">
                        <span>{{ section.settings.title }}</span>
                    </h3>
                    {%- endif -%}
                    <ul class="nav nav-tabs nav-tabs-1 d-inline-flex style-{{ style_tab }}" role="tablist">
                        {%- for block in section.blocks -%}
                        <li class="nav-item" role="presentation">
                        <a id="{{ block.id }}-tab" class="nav-link nav-link-{{ block.id }} {% if forloop.first %}active{% endif %}" data-toggle="tab" href="#prdtab-{{block.id}}" role="tab" aria-controls="prdtab-{{ block.id }}" {{ block.shopify_attributes }}>
                            {{ block.settings.title }}
                        </a>
                        </li>
                        {%- endfor -%}
                    </ul>
                    {%- if section.settings.button_heading != blank or section.settings.link_heading != blank -%}
                        <div class="btn-heading">
                            <a href="{{ section.settings.link_heading }}" class="btn {{ section.settings.style_btn }}">
                                {{ section.settings.button_heading }}
                                {% render 'icon-arrow-2' %}
                            </a>
                        </div>
                    {%- endif -%}
                </div>

                {% if section.settings.arrow_heading %}
                <div style="gap: 2px;" class="btn-prev-next d-flex position-relative justify-content-md-end justify-content-center swiper-wrapper-{{ section.id }}">
                    <div class="swiper-button-prev position-static mt-0">
                        {% render "icon-swiper-prev" %}
                    </div>
                    <div class="swiper-button-next position-static mt-0">
                        {% render "icon-swiper-next" %}
                    </div>
                </div>
                {% endif %}
            </div>

            <div class="banner-w-tab d-flex flex-sm-row flex-column {% if section.settings.banner_right %}flex-sm-row-reverse flex-column-reverse{% endif %}">
                <div class="tab-banner">                 
                    <div class="image-content__image-container overflow-hidden">
                    {%- if section.settings.image != blank -%}
                        <div class="h-100" >
                            {% assign img_url = section.settings.image | image_url: width: 1 | replace: 'width=1', 'width={width}' %}
                            <img class="image-content__image lazyload scale-in w-100 h-100 object-fit-cover"
                                src="{{ section.settings.image | image_url: width: 720 }}"
                                data-src="{{ img_url }}"
                                data-widths="[180, 360, 540, 720, 900, 1080, 1296, 1512, 1728, 1944, 2048]"
                                data-aspectratio="{{ section.settings.image.aspect_ratio }}"
                                data-sizes="auto"
                                alt="{{ section.settings.image.alt | escape }}"
                                loading="lazy"
                                width="{{ section.settings.image.width }}"
                                height="{{ section.settings.image.height }}"> 
                        </div>
                        {%- else -%}
                        <div class="image-content__image h-100 ">
                            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                        </div>
                    {%- endif -%}

                        <div class="product-image__banner position-absolute">
                                <div  class="product-image__banner_in">
                                    {%- if section.settings.subtitle_banner != blank -%}
                                        <div class="subtop mb-1">{{ section.settings.subtitle_banner }}</div>
                                    {%- endif -%}
                                    {%- if section.settings.title_banner != blank -%}
                                    <h3 class="mb-30 text-uppercase {{ section.settings.size_text }}"><a href="{{ section.settings.link }}" >{{ section.settings.title_banner }}</a></h3>
                                    {%- endif -%}
                                    {%- if section.settings.button != blank and section.settings.link != blank -%}
                                    <div class="pt-0">
                                        <a href="{{ section.settings.link }}" class="btn {{ section.settings.style_btn_banner }}">
                                          {{ section.settings.button | escape }}
                                          {% render 'icon-arrow-2' %}
                                        </a>
                                    </div>
                                    {%- endif -%}
                                </div>
                        </div>
                        
                    </div>              
                </div>
                <div class="tab-content" data-aos="{{ section.settings.animation }}">
                  {%- for block in section.blocks -%}
                      {%- assign collection = collections[block.settings.collection] -%}
                      {%- assign limit = section.settings.limit -%}
                      <div class="tab-pane fade {% if forloop.first %}show active{% endif %}" id="prdtab-{{ block.id }}" role="tabpanel" aria-labelledby="{{ block.id }}-tab">
                          <div class="prdtab-content swiper-wrapper-{{ section.id }}">
                              <div class="productlist-swiper swiper-container swipercol-{{ section.id }}" id="Productlist-{{ section.id }}"
                                  data-section-id="{{ section.id }}"  
                                  data-section-type="swipercustom"
                                  data-perview-desktop="{{ section.settings.perviewDesktop }}"
                                  data-perview-tablet="{{ section.settings.perviewTablet }}"
                                  data-perview-mobile="{{ section.settings.perviewMobile }}"
                                  data-space-between="{{ section.settings.spaceBetween }}"
                                  >
                                  <div class="swiper-wrapper">
                                      {%- if collection != blank -%}
                                      {%- for product in collection.products limit: limit -%}
                                          <div class="producttab-item swiper-slide" data-scroll data-scroll-speed="1">
                                              <div class="h-100" style="--g-color-heading : {{ settings.color_body_headings }};
                                              --g-color-heading-rgb:{{ settings.color_body_headings.red }}, {{ settings.color_body_headings.green }}, {{ settings.color_body_headings.blue }};
                                              --color-body-text: {{ settings.color_body_text }};
                                              --color-body-text-rgb: {{ settings.color_body_text.red }}, {{ settings.color_body_text.green }}, {{ settings.color_body_text.blue }};">
                                                  {%- render 'product-card', product: product -%}
                                              </div>
                                          </div>
                                      {%- endfor -%}
                                      {%- else -%}
                                      {%- for i in (1..limit) -%}
                                      <div class="producttab-item swiper-slide">
                                          <div data-aos="{{ section.settings.animation }}"  data-aos-delay="{{ forloop.index | times: 100 }}">
                                              {%- render 'product-grid-blank' -%}
                                          </div>
                                      </div>
                                      {%- endfor -%}
                                      {%- endif -%}
                                  </div>
  
                                  {% if section.settings.arrow_heading != true %}
                                      {%- if section.settings.arrows -%}
                                      <div class="swiper-button-prev">
                                          {% render "icon-swiper-prev" %}
                                      </div>
                                      <div class="swiper-button-next">
                                          {% render "icon-swiper-next" %}
                                      </div>
                                      {%- endif -%}
                                  {% endif %}
                              </div>
                          </div>
                      </div>
                  {%- endfor -%}
                </div>
            </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pestañas de producto",
  "class": "index-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "select",
      "id": "animation",
      "options": [
        {
          "value": "",
          "label": "Ninguno"
        },
        {
          "value": "fade",
          "label": "Desvanecer"
        },
        {
          "value": "fade-up",
          "label": "Desvanecer arriba"
        },
        {
          "value": "fade-down",
          "label": "Desvanecer abajo"
        },
        {
          "value": "fade-left",
          "label": "Desvanecer izquierda"
        },
        {
          "value": "fade-right",
          "label": "Desvanecer derecha"
        },
        {
          "value": "fade-up-right",
          "label": "Desvanecer arriba derecha"
        },
        {
          "value": "fade-up-left",
          "label": "Desvanecer arriba izquierda"
        },
        {
          "value": "fade-down-right",
          "label": "Desvanecer abajo derecha"
        },
        {
          "value": "fade-down-left",
          "label": "Desvanecer abajo izquierda"
        },
        {
          "value": "flip-up",
          "label": "Voltear arriba"
        },
        {
          "value": "flip-down",
          "label": "Voltear abajo"
        },
        {
          "value": "flip-left",
          "label": "Voltear izquierda"
        },
        {
          "value": "flip-right",
          "label": "Voltear derecha"
        },
        {
          "value": "slide-up",
          "label": "Deslizar arriba"
        },
        {
          "value": "slide-down",
          "label": "Deslizar abajo"
        },
        {
          "value": "slide-left",
          "label": "Deslizar izquierda"
        },
        {
          "value": "slide-right",
          "label": "Deslizar derecha"
        },
        {
          "value": "zoom-in",
          "label": "Acercar"
        },
        {
          "value": "zoom-in-up",
          "label": "Acercar arriba"
        },
        {
          "value": "zoom-in-down",
          "label": "Acercar abajo"
        },
        {
          "value": "zoom-in-left",
          "label": "Acercar izquierda"
        },
        {
          "value": "zoom-in-right",
          "label": "Acercar derecha"
        },
        {
          "value": "zoom-out",
          "label": "Alejar"
        },
        {
          "value": "zoom-out-up",
          "label": "Alejar arriba"
        },
        {
          "value": "zoom-out-down",
          "label": "Alejar abajo"
        },
        {
          "value": "zoom-out-left",
          "label": "Alejar izquierda"
        },
        {
          "value": "zoom-out-right",
          "label": "Alejar derecha"
        }
      ],
      "label": "Seleccionar animación"
    },
    {
      "type": "select",
      "id": "setwidth",
      "label": "Ancho completo",
      "default": "container",
      "options": [
        {
          "value": "container",
          "label": "Caja"
        },
        {
          "value": "container-fluid",
          "label": "Contenedor fluido"
        },
        {
          "value": "full",
          "label": "Completo"
        }
      ]
    },
    {
      "type": "color",
      "id": "bgsection",
      "label": "Fondo de la sección",
      "default": "#ffffff"
    },
    {
      "type": "header",
      "content": "Encabezado"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Título",
      "default": "Product tab"
    },
    {
      "type": "liquid",
      "id": "button_heading",
      "label": "Texto del botón",
      "default": "discover now"
    },
    {
      "type": "url",
      "id": "link_heading",
      "label": "Enlace del botón"
    },
    {
      "type": "select",
      "id": "style_btn",
      "label": "Estilo del botón",
      "default": "btn-underline btn-underline-white",
      "options": [
        {
          "value": "btn-theme",
          "label": "Botón caja"
        },
        {
          "value": "btn-theme btn-white",
          "label": "Botón caja blanco"
        },
        {
          "value": "btn-underline",
          "label": "Botón línea"
        },
        {
          "value": "btn-underline btn-underline-white",
          "label": "Botón línea blanco"
        },
        {
          "value": "btn-outline",
          "label": "Botón contorno"
        },
        {
          "value": "btn-outline btn-outline-white",
          "label": "Botón contorno blanco"
        }
      ]
    },
    {
      "type": "select",
      "id": "style_tab",
      "label": "Estilo de pestaña",
      "default": "line",
      "options": [
        {
          "value": "line",
          "label": "Línea"
        },
        {
          "value": "button",
          "label": "Botón"
        }
      ]
    },
    {
      "type": "header",
      "content": "Configuración del banner"
    },
    {
      "type": "checkbox",
      "id": "banner_right",
      "label": "Banner a la derecha",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Imagen"
    },
    {
      "type": "liquid",
      "id": "subtitle_banner",
      "label": "Subtítulo",
      "default": "Sub Title"
    },
    {
      "type": "color",
      "id": "color_sub",
      "label": "Color de subtítulo",
      "default": "#ffffff"
    },
    {
      "type": "liquid",
      "id": "title_banner",
      "label": "Título",
      "default": "Title Banner"
    },
    {
      "type": "color",
      "id": "color_title",
      "label": "Color de título",
      "default": "#ffffff"
    },
    {
      "type": "select",
      "id": "size_text",
      "default": "h2",
      "options": [
        {
          "value": "h1",
          "label": "H1"
        },
        {
          "value": "h2",
          "label": "H2"
        },
        {
          "value": "h3",
          "label": "H3"
        },
        {
          "value": "h4",
          "label": "H4"
        },
        {
          "value": "h5",
          "label": "H5"
        },
        {
          "value": "h6",
          "label": "H6"
        }
      ],
      "label": "Tamaño de encabezado"
    },
    {
      "type": "text",
      "id": "button",
      "label": "Texto del botón 1",
      "default": "discover now"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Enlace del botón 1"
    },
    {
      "type": "select",
      "id": "style_btn_banner",
      "label": "Estilo del botón 1",
      "default": "btn-underline btn-underline-white",
      "options": [
        {
          "value": "btn-theme",
          "label": "Botón caja"
        },
        {
          "value": "btn-theme btn-white",
          "label": "Botón caja blanco"
        },
        {
          "value": "btn-underline",
          "label": "Botón línea"
        },
        {
          "value": "btn-underline btn-underline-white",
          "label": "Botón línea blanco"
        },
        {
          "value": "btn-outline",
          "label": "Botón contorno"
        },
        {
          "value": "btn-outline btn-outline-white",
          "label": "Botón contorno blanco"
        }
      ]
    },
    {
      "type": "header",
      "content": "Configuración del producto"
    },
    {
      "type": "range",
      "id": "limit",
      "min": 3,
      "max": 30,
      "step": 1,
      "label": "Límite de elementos",
      "default": 10
    },
    {
      "type": "range",
      "id": "perviewDesktop",
      "label": "Por vista escritorio",
      "max": 6,
      "min": 1,
      "step": 1,
      "unit": " c",
      "default": 3
    },
    {
      "type": "range",
      "id": "perviewTablet",
      "label": "Por vista tablet",
      "max": 8,
      "min": 1,
      "step": 1,
      "unit": " c",
      "default": 3
    },
    {
      "type": "range",
      "id": "perviewMobile",
      "label": "Por vista móvil",
      "max": 8,
      "min": 1,
      "step": 1,
      "unit": " c",
      "default": 1
    },
    {
      "type": "range",
      "id": "spaceBetween",
      "label": "Espacio entre",
      "max": 40,
      "min": 0,
      "step": 1,
      "unit": " sp",
      "default": 30
    },
    {
      "type": "checkbox",
      "id": "arrows",
      "label": "Flechas",
      "default": true
    },
    {
      "label": "Flecha en encabezado",
      "id": "arrow_heading",
      "type": "checkbox",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "scrollbar",
      "label": "Barra de desplazamiento",
      "default": true
    },
    {
      "type": "header",
      "content": "Relleno de sección "
    },
    {
      "type": "text",
      "id": "paddingsection",
      "label": "Relleno de sección",
      "default": "0px 0px 0px 0px",
      "info": "Padding: Top Right Bottom Left"
    },
    {
      "type": "text",
      "id": "paddingtablet",
      "label": "Relleno sección tablet",
      "info": "Padding: Top Right Bottom Left"
    },
    {
      "type": "text",
      "id": "paddingmobile",
      "label": "Relleno sección móvil",
      "default": "40px 0px 40px 0px",
      "info": "Padding: Top Right Bottom Left"
    },
    {
      "type": "header",
      "content": "Margen de sección "
    },
    {
      "type": "text",
      "id": "marginsection",
      "label": "Margen de sección",
      "default": "0px 0px 0px 0px",
      "info": "Margin: Top Right Bottom Left"
    },
    {
      "type": "text",
      "id": "margintablet",
      "label": "Margen sección tablet",
      "info": "Margin: Top Right Bottom Left"
    },
    {
      "type": "text",
      "id": "marginmobile",
      "label": "Margen en móvil",
      "default": "0px 0px 0px 0px",
      "info": "Margin: Top Right Bottom Left"
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Colección",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Título",
          "default": "Title tab"
        },
        {
          "label": "Colección",
          "id": "collection",
          "type": "collection"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pestañas de producto",
      "category": "Collection",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}