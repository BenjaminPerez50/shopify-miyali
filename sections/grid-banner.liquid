<!-- grid-banner.liquid -->

<style>
  {%- if section.settings.show_overlay %}
    {% assign hex2rgb_hex = section.settings.bg_overlay %}
    .customstyle{{ section.id }} .banner-theme .banner-overlay{
      position: absolute;
      top:0;
      right:0;
      bottom:0;
      left: 0;
      {%- if section.settings.gradient_overlay -%}
        background:linear-gradient(180deg, rgb({{ hex2rgb_hex.red }}, {{ hex2rgb_hex.green }}, {{ hex2rgb_hex.blue }}, 0) 0%, rgb({{ hex2rgb_hex.red }}, {{ hex2rgb_hex.green }}, {{ hex2rgb_hex.blue }},{{ section.settings.opacity_overlay }}) 100%);
      {%- else -%}
        background-color: rgb({{ hex2rgb_hex.red }}, {{ hex2rgb_hex.green }}, {{ hex2rgb_hex.blue }}, {{ section.settings.opacity_overlay }});
      {%- endif -%}
      opacity: 1;
      z-index: 1;
    }
  {%- endif -%}

  @media (min-width: 1200px) {
    .customstyle{{ section.id }} .rte-setting {
      font-size: 16px;
      line-height: 20px;
    }
    .customstyle{{ section.id }} .banner-theme .h2 {
      font-size: calc(var(--g-h2-font-size) - 4px);
    }     
    .customstyle{{ section.id }} .banner-theme .h3 {
      font-size: calc(var(--g-h3-font-size) - 2px);
    }    
    {% if section.settings.padding_inner != blank %}
    .customstyle{{ section.id }} .banner-theme figcaption {
      padding: {{ section.settings.padding_inner }};
    }
    {% endif %}
  }

  @media (min-width: 768px) and (max-width: 991px) {
    .customstyle{{ section.id }} h3.h2 {
      font-size: calc(var(--g-h2-font-size) - 20px);
    }
  }
</style>

<div class="customstyle{{ section.id }}" data-aos="{{ section.settings.animation }}" >
  {%- render 'style-section' -%}
  <div class="{{ section.settings.setwidth }}">
    <div class="section-block">
      {%- render 'section-heading' -%}
      <div class="row {% if section.settings.no_gutter %}no-gutters{% endif %}">
        {%- for block in section.blocks -%}
        {%- assign text_color = block.settings.colordef -%}

        <div class="col-md-{{ block.settings.width }}" {{ block.shopify_attributes }} data-aos="{{ section.settings.animation }}" data-aos-delay="{{ forloop.index | times: 100 }}">
          <figure class="banner-theme hv-image-saturate banner-theme-{{ block.settings.vertical }} banner-theme-{{ block.settings.horizontal }} text-{{ block.settings.text_align }} {% if section.settings.no_gutter %}m-0{% endif %} banner-theme-{{ block.id }}"
          style="{% if text_color != 'transparent' %}
            --g-font-color-subtop: {{ block.settings.color_subtitle }};
            --g-color-heading :  {{ block.settings.color_heading }};
            --color-body-text : {{ text_color }};
            --color-body-text-rgb: {{ text_color.red }}, {{ text_color.green }},  {{ text_color.blue }} ;
          {% endif %}
          --g-figcaption-des: {{ block.settings.bg_color }};
          --g-figcaption-op: {{ block.settings.opacity_bg }};"
        >
            {%- if block.settings.image != blank -%}
              <style>
                {%- if block.settings.image != blank -%}
                .customstyle{{ section.id }} .banner-theme img {
                  height: {{ block.settings.image.height }}px;
                  object-fit: cover;
                }
                {%- endif -%}
                {%- if block.settings.image_mobile != blank -%}
                .customstyle{{ section.id }} .banner-theme img {
                  height: {{ block.settings.image_mobile.height }}px;
                  object-fit: cover;
                }
                {%- endif -%}
              </style>
            <img 
              src="{{ block.settings.image | image_url: width: 1, height: 1 }}" 
              class="lazyload transition scale-in {% if block.settings.image_mobile != blank %} d-none d-lg-block {% endif %}" 
              data-src="{{ block.settings.image | image_url: width: 1920 }}"
              loading="lazy"
              alt=""
              width="{{ block.settings.image.width }}"
              height="{{ block.settings.image.height }}">
              {%- if block.settings.image_mobile != blank -%}
              <img 
                src="{{ block.settings.image_mobile | image_url: width: 1, height: 1 }}" 
                class="lazyload transition  {% if block.settings.image_mobile != blank %} d-lg-none {% endif %}" 
                data-src="{{ block.settings.image_mobile | image_url: width: 1920 }}"
                loading="lazy"
                alt=""
                width="{{ block.settings.image_mobile.width }}"
                height="{{ block.settings.image_mobile.height }}">
              {%- endif -%}
            <a class="banner-overlay d-none" href="{{ block.settings.button_link | default: "#" }}"></a>
            {%- else -%}
            {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            <figcaption class="figcaption--{{ block.id }} {% if block.settings.vertical == "top" %}h-100{% endif %}">
                <div class="position-relative {% if block.settings.vertical == "top" %}h-100{% endif %}">
                  <div class="bg-des"></div>
                  <div class="position-relative {% if block.settings.opacity_bg > 0 %} p-4 {% endif %} {% if block.settings.vertical == "top" %}d-flex flex-column justify-content-between h-100{% endif %}" style="z-index: 3;">
                    <div class="gridbanner-text_top">
                      {%- if block.settings.subtitle != blank -%}
                        <div class="subtop {% if block.settings.description != blank %}mb-0{% else %}mb-0{% endif %}">{{ block.settings.subtitle }}</div>
                      {%- endif -%}
                      {%- if block.settings.title != blank -%}
                      <h3 class="{% if block.settings.description != blank and block.settings.button_text != blank %} mb-1 {% else %} mb-2 {% endif %} {{ block.settings.size_text }} text-uppercase">{{ block.settings.title }}</h3>
                      {%- endif -%}
                      {%- if block.settings.description != blank -%}
                        <div class="rte-setting {% if block.settings.button_text != blank %}mb-2 pb-1{% endif %} txt-body">{{ block.settings.description }}</div>
                      {%- endif -%}
                    </div>

                    {%- if block.settings.button_text != blank -%}
                      <div class="{% if block.settings.vertical == "top" %}text-right{% endif %}">
                        <a href="{{ block.settings.button_link }}" class="btn {{ block.settings.style_btn }} {{ block.settings.size_btn }}">
                          {{ block.settings.button_text }}
                          {% render 'icon-arrow-2' %}
                        </a>
                      </div>  
                    {%- endif -%}

                  </div>
                </div>
            </figcaption>		
          </figure>
        </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</div>

