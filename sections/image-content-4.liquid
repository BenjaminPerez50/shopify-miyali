<!-- image-content-4.liquid -->
 <style>
  .customstyle{{ section.id }} .icr-text {
    position: absolute;
    top: 0;
    right: 0;
    text-align: right;
    padding: 46px 43px;
  }
  .customstyle{{ section.id }} .swiper-pagination {
    bottom: 43px;
    right: 0;
    left: unset;
    padding: 0 43px;
    width: auto;
    display: flex;
    align-items: center;
  }
  .customstyle{{ section.id }} .swiper-pagination-bullet {
    opacity: 1;
  }
  .customstyle{{ section.id }} .swiper-pagination-bullet-active {
    background: transparent;
    border: 2px solid #000;
    width: 14px;
    height: 14px;
  }
  .customstyle{{ section.id }} .description-1 {
    font-size: calc(var(--g-font-size) + 2px);
  }
  .customstyle{{ section.id }} .description-1 ,
  .customstyle{{ section.id }} .description-3 {
    color: var(--g-color-heading);
  }
  .customstyle{{ section.id }} .description-3 svg {
    color: var(--g-main);
  }
  @media (min-width: 1200px) {
    .customstyle{{ section.id }} .image-content_center {
      padding-right: 52.5px;
    }
    .customstyle{{ section.id }} .image-content_right {
      padding-top: 30px;
      padding-left: 15px;
    }
  }
  @media (min-width: 1600px) {
    .customstyle{{ section.id }} .swiper-pagination {
      bottom: unset;
      transform: translateY(50%);
      top: 45%;
    }
  }
  @media (max-width: 767px) {
    .customstyle{{ section.id }} .swiper-pagination {
      bottom: 10px;
      padding-right: 20px;
    }
    .customstyle{{ section.id }} .icr-text {
      padding: 46px 20px;
      background-color: var(--g-main-2);
      bottom: 0;
    }
    .customstyle{{ section.id }} .image-content__image-wrapper {
      min-height: 300px;
    }
  }
 </style>
<div class="customstyle{{ section.id }} img-section" data-aos="{{ section.settings.animation }}">
    {%- render 'style-section' -%}
  <div class="{{ section.settings.setwidth }}">
    <div class="section-block">
      <div class="row justify-content-between">
        <div class="image-content_center col-xl-7 col-12 mb-xl-0 mb-4" data-aos="{{ section.settings.animation }}" data-aos-duration="500">
          <div class="imgcontent-swiper swiper-container swipercol-{{ section.id }}" id="imgcontent-{{ section.id }}"
            data-section-id="{{ section.id }}"  
            data-section-type="swipercustom"
            data-perview-desktop="1"
            data-perview-tablet="1"
            data-perview-mobile="1"
            data-space-between="0">
            <div class="swiper-wrapper">
              {%- for block in section.blocks -%}
                <div class="swiper-slide img-sectionright position-relative">
                  {%- if block.settings.image != blank -%}
                    <div class="image-content__image-container">
                        <div class="image-content__image-wrapper" style="padding-top:{{ 1 | divided_by: block.settings.image.aspect_ratio | times: 100 }}%;">
                        {% assign img_url = block.settings.image | image_url: width: 1 | replace: 'width=1', 'width={width}' %}
                        <img class="image-content__image lazyload h-100 object-fit-cover"
                            src="{{ block.settings.image | image_url: width: 650 }}"
                            data-src="{{ img_url }}"
                            data-widths="[180, 360, 540, 720, 900, 1080, 1296, 1512, 1728, 1944, 2048]"
                            data-aspectratio="{{ block.settings.image.aspect_ratio }}"
                            data-sizes="auto"
                            alt="{{ block.settings.image.alt | escape }}"
                            loading="lazy"
                            width="{{ block.settings.image.width }}"
                            height="{{ block.settings.image.height }}">
                        </div>
                    </div>
                  {%- else -%}
                    <div class="image-content__image">
                      {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
                    </div>
                  {%- endif -%}
      
                  {% if block.settings.title != blank or block.settings.description != blank %}
                  <div class="icr-text">
                    <div class="d-flex flex-column justify-content-between h-100">
                      {% if block.settings.description != blank  %}
                        <div class="rte-setting mb-3" >{{ block.settings.description }}</div>
                      {% endif %}
                      {% if  block.settings.title != blank %}
                        <div class="h4 text-uppercase">{{ block.settings.title }}</div>
                      {% endif %}
                    </div>
                  </div>
                  {% endif %}
                </div>
              {%- endfor -%}
            </div>
            {% if section.settings.dots %}
              <div class="swiper-pagination"></div>
            {% endif %}
          </div>
        </div>
        <div class="image-content_right col-xl-5 col-12" data-aos="{{ section.settings.animation }}" data-aos-duration="700">
          <div class="h-100 flex w-100">
              <div class="flex__item image-content__text text-{{ section.settings.align }} p-xl-0 px-md-3 py-md-0 py-3">
                {% if section.settings.subtitle != blank %}
                <div class="mb-30 subtop" >{{ section.settings.subtitle }}</div>
                {% endif %}
                {% if  section.settings.title != blank %}
                <div class="mb-4 {{ section.settings.size_text }}">{{ section.settings.title }}</div>
                {% endif %}
                {% if section.settings.text != blank  %}
                  <div class="description-1 fw-semibold rte-setting mb-18" >{{ section.settings.text }}</div>
                {% endif %}
                {% if section.settings.text_2 != blank  %}
                  <div class="rte-setting mb-3" >{{ section.settings.text_2 }}</div>
                {% endif %}
                {% if section.settings.text_3 != blank  %}
                  <div class="rte-setting description-3 fw-semibold mb-18 d-flex flex-column" >
                    {% assign features = section.settings.text_3 | newline_to_br | split: '<br />' %}
                    {% for feature in features %}
                      {% unless feature == blank %}
                        <span style="line-height: 30px;gap: 15px;" class="d-flex align-items-center">
                          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20" fill="none">
                            <path d="M12.5 0C10.875 0 9.125 0 7.5 0C3 0.5 0.5 3 0 7.5C0 9.125 0 10.875 0 12.5C0.5 17 3 19.5 7.5 20C9.125 20 10.875 20 12.5 20C17 19.5 19.5 17 20 12.5C20 10.875 20 9.125 20 7.5C19.5 3 17 0.5 12.5 0ZM14.75 8.375L10.125 13.375C9.625 13.875 8.875 13.875 8.375 13.5L5.5 11C5 10.5 4.875 9.625 5.375 9.125C5.875 8.625 6.625 8.625 7.125 9L9 10.75L12.875 6.625C13.375 6.125 14.125 6.125 14.625 6.625C15.125 7 15.25 7.875 14.75 8.375Z" fill="currentColor"/>
                          </svg>
                          {{ feature | strip }}
                        </span>
                      {% endunless %}
                    {% endfor %}
                  </div>
                {% endif %}
                {%- if section.settings.button != blank -%}
                  <div class="">
                    <a href="{{ section.settings.link }}" class="btn btn-theme btn-main-2">
                      {{ section.settings.button }}
                    </a>
                  </div>
                {%- endif -%}
              </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
  
