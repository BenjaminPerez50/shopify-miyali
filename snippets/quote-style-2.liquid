<div class=" d-flex {% if aligntext == 'text-center' %} justify-content-center {% endif %} quote__slide quote__style_2 {{ aligntext }} ">
    <div class="quote-wrap" >
        <div class="media mb-20 align-items-center">
            {%- if avatar != blank -%}
                <div class="author-avatar mr-3 mt-0">
                  <img class="lazyload" src="{{ avatar | image_url: width: 1 , height: 1 }}" data-src="{{ avatar | image_url: width: 300 }}" 
                    loading="lazy"
                    width="{{ avatar.width }}"
                    height="{{ avatar.height }}"/>
                </div>
            {%- endif -%}
            <div class="media-body text-left">
              {%- if author -%}
                  <div class="h6 mb-1">{{ author }} </div>
              {%- endif -%}
              {%- if info != blank -%}<span class="mini-text">  {{ info }}</span>{%- endif -%}
            </div>
        </div>
        {%- if title != blank -%}
            <h4 class="mt-2">
                {{ title }}
            </h4>
        {%- endif -%}
        <div class="quote-content {{ size_text }} mb-20">{{ quote }}</div>
        {%- if rate > 0 -%}
          <div style="gap: 6px;" class="rating-wrap mb-4 d-flex align-items-center {% if aligntext == 'text-center' %} justify-content-center {% endif %}">
            <ul class="rating" aria-hidden="true">
              {%- for i in (1..5) -%}
                {%- assign iMax = rate -%}
                {%- if i <= iMax -%}
                  <li class="rated">
                    <svg aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                  </li>
                {%- else -%}
                  <li>
                    <svg aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>

            {%- assign rate_times10 = rate | times: 10 | round -%}
            {%- assign rate_int = rate_times10 | divided_by: 10 -%}
            {%- assign rate_dec = rate_times10 | modulo: 10 -%}

            <div style="color: var(--color-body-text);margin-top:3px;" class="mini-text numeric-rating" aria-label="Rating numeric">
              {{ rate_int }}.{{ rate_dec }}
            </div>
          </div>
        {%- endif -%}
    </div>
  </div>