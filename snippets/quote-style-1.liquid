<style>
  .quote__style_1 .author-avatar {
    width: 54px;
    height: 54px;
    margin-top: 0;
  }
  .quote__slide.quote__style_1 {
    height: 100%;
  }
</style>
<div class="d-flex {% if aligntext == 'text-center' %} justify-content-center {% endif %} quote__slide quote__style_1 {{ aligntext }} ">
    <div class="quote-wrap" >
        <div class="quote-wrap-top d-flex align-items-center mb-4 pb-1 {% if aligntext == 'text-center' %} justify-content-center {% elsif aligntext == 'text-right' %} justify-content-end {% endif %}">
          {%- if title != blank -%}
          <h5 class="h1 mb-0">
            {{ title }}
          </h5>
          {%- endif -%}
          <div class="text-left">
            <div class="h6 mb-1">
              {{ author }}
            </div>
            {%- if info != blank -%}
              <span style="color: var(--color-accent-3);font-size: 14px;line-height: 18px;font-weight: 500;align-items: center;gap: 6px;margin: 0 0 7px;" class="capitalize d-flex">  
                {{ info }}
              </span>
            {%- endif -%}
            {%- if rate > 0 -%}
              <ul class="rating mb-0">
                {%- for i in (1..5) -%}
                  {%- assign iMax = rate -%}
                  {%- if i <= iMax -%}
                  <li class="rated">
                    <svg aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                      {%- else -%}
                  <li>
                    <svg aria-hidden="true" focusable="false" width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"></path></svg>
                    {%- endif -%}
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        </div>
        <div class="{{ size_text }} {%- if avatar != blank -%}mb-5 pb-2{% else %}mb-0{%- endif -%}">
          {{ quote }}
        </div>
        {%- if avatar != blank -%}
          <div class="author-avatar mr-3">
            <img class="lazyload" src="{{ avatar | image_url: width: 1 , height: 1 }}" data-src="{{ avatar | image_url: width: 300 }}" 
              loading="lazy" alt=""
              width="{{ avatar.width }}"
              height="{{ avatar.height }}"/>
          </div>
        {%- endif -%}   
    </div>
</div>     